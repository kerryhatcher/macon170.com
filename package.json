{
  "name": "macon170-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 41771",
    "dev:worker": "bun run build && wrangler dev --ip 0.0.0.0",
    "start": "astro dev --host 0.0.0.0 --port 41771",
    "build": "astro check && astro build",
    "check": "astro check && tsc --noEmit --project tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "LIVE_BASE_URL=https://www.macon170.com playwright test e2e/contact-turnstile.live.spec.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "e2e:server": "bun run build && wrangler dev --config wrangler.e2e.jsonc --port 8790",
    "deploy:dry": "bun run build && wrangler deploy --dry-run",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "astro": "latest",
    "typescript": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "acorn": "^8.17.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
