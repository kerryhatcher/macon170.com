{
  "name": "macon170-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "npm run build && wrangler dev --env-file .dev.vars",
    "start": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check && tsc --noEmit --project tsconfig.worker.json && wrangler types --check worker-configuration.d.ts",
    "test": "vitest run",
    "preview": "astro preview",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply macon170-submissions --local",
    "db:migrate:remote": "wrangler d1 migrations apply macon170-submissions --remote",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "astro": "latest",
    "jose": "^6.2.4",
    "typescript": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^26.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
