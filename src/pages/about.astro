---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterHero from '../components/ChapterHero.astro';
import { pack } from '../data/pack';
// Real Pack 170 photos, used with the families' permission. They back the two claims on this page
// that a drawing can't: that the pack is genuinely ours, and that adult volunteers run it.
import advancement from '../../assets/packphotos/award2.jpg';
import denLeader from '../../assets/packphotos/Stephanie_awards.jpeg';
// The Scout hut on the church grounds, shared by Pack 170 and Troop 170 (confirmed 2026-07-28).
// Source AVIF from the church's own site, so it is the church's photograph rather than the pack's.
import scoutHut from '../../assets/packphotos/scout-hut.avif';
import practiceTogether from '../../assets/packphotos/9-576A9059.jpg';
import { externalLink } from '../lib/external-link';

type LeadershipEntry = {
  title: string;
  data: {
    name?: string;
    section?: 'pack-leadership' | 'den-leaders';
    sortOrder?: number;
  };
};

type LeadershipResponse = { data?: LeadershipEntry[] };

const cmsRosterUrl = import.meta.env.DEV
  ? 'http://kudzu:41772/api/collections/leadership-roster/content'
  : 'https://cms.macon170.com/api/collections/leadership-roster/content';
const leadershipSections = [
  ['pack-leadership', 'Who leads Pack 170'],
  ['den-leaders', 'Den Leaders'],
] as const;

let initialLeadershipEntries: LeadershipEntry[] = [];
try {
  const response = await fetch(cmsRosterUrl, { signal: AbortSignal.timeout(5_000) });
  if (response.ok) {
    const body = (await response.json()) as LeadershipResponse;
    initialLeadershipEntries = body.data ?? [];
  }
} catch {
  // The browser refresh below gets another chance. If it also fails, the roster stays blank.
}
---

<BaseLayout
  title="Our neighborhood pack"
  description="Learn about Cub Scout Pack 170, our Shirley Hills meeting home, family welcome, and volunteer-led program."
>
  <ChapterHero
    chapter="Our pack"
    title="Rooted in"
    accent="Macon"
    intro="Pack 170 is a volunteer-run Cub Scout pack serving elementary-age children and their families from our meeting home in historic Shirley Hills."
    noteTitle="The plain facts"
    noteBody={`${pack.grades} · ${pack.welcome}`}
    ><p slot="note">Pack meetings happen roughly monthly on Tuesdays at 6:30 PM.</p></ChapterHero
  >
  <section class="section">
    <div class="container story-grid">
      <div>
        <span class="chapter-tab">The neighborhood chapter</span><h2>A local pack with a wide-open welcome.</h2><p class="lead">
          Our pack is chartered by Highland Hills Baptist Church, where we meet and where many dens gather before the pack meeting.
        </p><p>
          The church charters the pack and supports its meeting home. Parents and registered adult volunteers deliver the Cub Scouting
          program. Families don't need to belong to the church, and Pack 170 welcomes boys and girls from every background.
        </p>
      </div><figure class="pack-photo">
        <Image
          src={advancement}
          alt="A Pack 170 den leader pins a rank badge on a Cub Scout's uniform at a pack meeting."
          widths={[420, 840]}
          width={840}
          height={1260}
          sizes="(max-width: 760px) 100vw, 42vw"
          loading="lazy"
        /><figcaption>A rank badge presented at a pack meeting · Shirley Hills, Macon</figcaption>
      </figure>
    </div>
    <div class="container">
      <!-- quality={68}: the hut source is already a compressed AVIF at its native 1272px, so a
        default-quality WebP re-encode gained nothing (222kB in, 221kB out). 68 halves it. -->
      <figure class="pack-photo pack-photo--hut">
        <Image
          src={scoutHut}
          alt="A dark timber Scout hut set back in the trees on the church grounds, with a flagpole and a Georgia-shaped sign reading “BSA Troop 170, Macon GA”."
          widths={[636, 1272]}
          width={1272}
          sizes="(max-width: 760px) 100vw, 68rem"
          loading="lazy"
          quality={68}
        /><figcaption>The Scout hut on the church grounds, shared by Pack 170 and Troop 170.</figcaption>
      </figure>
    </div>
  </section>
  <section class="section how-section">
    <div class="container">
      <div class="section-heading"><span class="chapter-tab">How the pack works</span><h2>Small dens. One whole pack.</h2></div><div
        class="how-flow"
      >
        <div><span>1</span><h3>Children join by grade</h3><p>A den is a small, same-grade Cub Scout group.</p></div><div>
          <span>2</span><h3>Dens choose a schedule</h3><p>Each den sets its own time and place; many meet before the pack gathering.</p>
        </div><div>
          <span>3</span><h3>Families gather as a pack</h3><p>Roughly once a month, everyone comes together at Highland Hills.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section promise-section">
    <div class="container promise-grid">
      <div class="promise-column">
        <div class="paper-sheet promise">
          <span class="chapter-tab">Our approach</span><h2>Do your best.</h2><p class="lead">
            Cub Scouting meets children where they are. Adults make space to practice; kids build confidence by trying.
          </p>
        </div>
        <figure class="pack-photo">
          <Image
            src={practiceTogether}
            alt="A Pack 170 adult volunteer crouches on a path beside a child, the two of them playing tic-tac-toe with hand-painted ladybug and bee stones on a slice of log."
            widths={[420, 840]}
            width={840}
            sizes="(max-width: 760px) 100vw, 42vw"
            loading="lazy"
          /><figcaption>Making space to practice, one hand-painted game at a time.</figcaption>
        </figure>
      </div><div>
        <h2>Volunteer-powered, family-supported.</h2><p>
          Pack adults provide program, training, planning, and safety. Families bring encouragement, participation, and the willingness to
          help when they can.
        </p><a class="button button--blue" href="/volunteer/">See ways to help</a>
      </div>
    </div>
  </section>
  <section class="section roster-section">
    <div class="container">
      <span class="chapter-tab">Pack leadership</span>
      <figure class="pack-photo pack-photo--wide">
        <Image
          src={denLeader}
          alt="A Pack 170 den leader speaks from the podium at a pack meeting."
          widths={[640, 1280]}
          width={1280}
          height={853}
          sizes="(max-width: 760px) 100vw, 60rem"
          loading="lazy"
        /><figcaption>
          Every den is led by a registered adult who has cleared a background check and youth protection training. <a
            href="/youth-protection/">How that screening works</a
          >.
        </figcaption>
      </figure>
      <div class="roster">
        <h2>Who leads Pack 170</h2>
        <p>Pack 170 is run by registered adult volunteers who are Youth Protection trained and background-checked.</p>
        <div id="leadership-roster" aria-live="polite">
          {
            leadershipSections.map(([sectionKey, sectionTitle]) => {
              const sectionEntries = initialLeadershipEntries
                .filter((entry) => entry.data.section === sectionKey)
                .sort((a, b) => (a.data.sortOrder ?? 0) - (b.data.sortOrder ?? 0));
              if (sectionEntries.length === 0) return null;

              return (
                <>
                  {sectionKey === 'den-leaders' && <h2>{sectionTitle}</h2>}
                  <ul>
                    {sectionEntries.map((entry) => (
                      <li>
                        <strong>{entry.title}</strong>
                        {entry.data.name?.trim()}
                      </li>
                    ))}
                  </ul>
                </>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>
  <section class="section council-section">
    <div class="container council-grid">
      <div>
        <span class="chapter-tab">Our Scouting home</span><h2>Part of something larger.</h2><p>
          Pack 170 is a unit of the Central Georgia Council, Scouting America. The council supports local units with training, program
          resources, camps, and the Macon Scout Shop.
        </p>
      </div><a class="button button--paper" href={pack.council.url} {...externalLink(pack.council.url)}>Visit the council website</a>
    </div>
  </section>
</BaseLayout>
<script>
  type LeadershipEntry = {
    title: string;
    data: {
      name?: string;
      section?: 'pack-leadership' | 'den-leaders';
      sortOrder?: number;
    };
  };

  type LeadershipResponse = { data?: LeadershipEntry[] };

  const roster = document.querySelector<HTMLElement>('#leadership-roster');
  const cmsRosterUrl = import.meta.env.DEV
    ? 'http://kudzu:41772/api/collections/leadership-roster/content'
    : 'https://cms.macon170.com/api/collections/leadership-roster/content';
  const sections = [
    ['pack-leadership', 'Who leads Pack 170'],
    ['den-leaders', 'Den Leaders'],
  ] as const;

  async function loadLeadershipRoster() {
    if (!roster) return;

    try {
      const response = await fetch(cmsRosterUrl);
      if (!response.ok) throw new Error(`CMS request failed with ${response.status}`);

      const body = (await response.json()) as LeadershipResponse;
      const entries = body.data ?? [];
      if (entries.length === 0) {
        roster.replaceChildren();
        return;
      }

      const fragment = document.createDocumentFragment();
      for (const [sectionKey, sectionTitle] of sections) {
        const sectionEntries = entries
          .filter((entry) => entry.data.section === sectionKey)
          .sort((a, b) => (a.data.sortOrder ?? 0) - (b.data.sortOrder ?? 0));
        if (sectionEntries.length === 0) continue;

        const list = document.createElement('ul');
        if (sectionKey === 'den-leaders') {
          const heading = document.createElement('h2');
          heading.textContent = sectionTitle;
          fragment.appendChild(heading);
        }
        for (const entry of sectionEntries) {
          const item = document.createElement('li');
          const role = document.createElement('strong');
          role.textContent = entry.title;
          item.appendChild(role);
          const name = entry.data.name?.trim();
          if (name) item.appendChild(document.createTextNode(name));
          list.appendChild(item);
        }
        fragment.appendChild(list);
      }

      if (!fragment.childNodes.length) {
        roster.replaceChildren();
        return;
      }
      roster.replaceChildren(fragment);
    } catch {
      // Retain the roster rendered during the static build if the live refresh fails.
    }
  }

  void loadLeadershipRoster();
</script>
<style>
  .story-grid,
  .promise-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .how-section {
    background: var(--page);
    border-block: 1px solid var(--rule);
  }
  .how-flow {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .how-flow div {
    padding: 2rem;
    border-top: 4px solid var(--blue);
    border-right: 1px dashed var(--rule);
  }
  .how-flow span {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-top: -3.7rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--gold);
    border: 4px solid var(--blue);
    font-family: var(--font-display);
    font-weight: 900;
  }
  .promise {
    padding: clamp(2rem, 5vw, 4rem);
    transform: rotate(-1deg);
  }
  /* The rotated sheet and the photo share one grid column, so the sheet keeps its tilt against the
     square photo below it rather than fighting the volunteer copy for width. */
  .promise-column {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  .roster-section {
    background: var(--page);
    border-block: 1px solid var(--rule);
  }
  /* .pack-photo itself is global (src/styles/global.css); only these placements are local. */
  .pack-photo--wide {
    max-width: 60rem;
    margin: 1.5rem 0 2.5rem;
  }
  /* The hut source is a 1272x588 banner crop, so it keeps its own ratio instead of the 4/5 default. */
  .pack-photo--hut {
    /* Matches the figure's `sizes`. Uncapped it filled the 1134px container and upscaled the
       1088px variant, which would otherwise force the heavier 1272px one for 46px of width. */
    max-width: 68rem;
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .pack-photo--hut img {
    aspect-ratio: 1272 / 588;
  }
  /* Styles any structure the Markdown grows: h2 sections, prose, and role lists. */
  .roster :global(h2) {
    margin-top: 2.5rem;
  }
  .roster :global(h2:first-child) {
    margin-top: 0.5rem;
  }
  .roster :global(h3) {
    margin-top: 2rem;
  }
  .roster :global(p) {
    max-width: 65ch;
  }
  .roster :global(ul) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1rem 2rem;
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  .roster :global(li) {
    position: relative;
    padding: 1rem 1.25rem;
    background: var(--paper);
  }
  /* A sewn-in bookmark tab at the corner, not a rail down the whole edge — the same treatment
     .rank-list li and .adventure-list li got in 0d91bfc. This roster was not in that sweep. */
  .roster :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 1.75rem;
    background: var(--blue);
  }
  /* A role with no name yet reads as vacant rather than as a broken card. */
  .roster :global(li:empty) {
    display: none;
  }
  .roster :global(strong) {
    display: block;
    font-family: var(--font-display);
  }
  .council-section {
    background: var(--blue-deep);
    color: white;
  }
  .council-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
  }
  .council-grid p {
    max-width: 65ch;
  }
  @media (max-width: 760px) {
    .story-grid,
    .promise-grid,
    .council-grid {
      grid-template-columns: 1fr;
    }
    .how-flow {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .how-flow div {
      border-right: 0;
    }
    .promise {
      transform: none;
    }
  }
</style>
