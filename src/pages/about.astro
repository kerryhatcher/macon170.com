---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterHero from '../components/ChapterHero.astro';
import { pack } from '../data/pack';
// Real Pack 170 photos, used with the families' permission. They back the two claims on this page
// that a drawing can't: that the pack is genuinely ours, and that adult volunteers run it.
import advancement from '../../assets/packphotos/award2.jpg';
import denLeader from '../../assets/packphotos/Stephanie_awards.jpeg';
// Leadership content lives entirely in Markdown — headings, sections, and prose included — so pack
// editors control it without touching code. Do not mirror any of it back into this file.
import { Content as Roster } from '../data/leadership.md';
import { externalLink } from '../lib/external-link';
---

<BaseLayout
  title="Our neighborhood pack"
  description="Learn about Cub Scout Pack 170, our Shirley Hills meeting home, family welcome, and volunteer-led program."
>
  <ChapterHero
    chapter="Our pack"
    title="Rooted in"
    accent="Macon"
    intro="Pack 170 is a volunteer-run Cub Scout pack serving elementary-age children and their families from our meeting home in historic Shirley Hills."
    noteTitle="The plain facts"
    noteBody={`${pack.grades} · ${pack.welcome}`}
    ><p slot="note">Pack meetings happen roughly monthly on Tuesdays at 6:30 PM.</p></ChapterHero
  >
  <section class="section">
    <div class="container story-grid">
      <div>
        <span class="chapter-tab">The neighborhood chapter</span><h2>A local pack with a wide-open welcome.</h2><p class="lead">
          Our pack is chartered by Highland Hills Baptist Church, where we meet and where many dens gather before the pack meeting.
        </p><p>
          The church charters the pack and supports its meeting home. Parents and registered adult volunteers deliver the Cub Scouting
          program. Families don't need to belong to the church, and Pack 170 welcomes boys and girls from every background.
        </p>
      </div><figure class="pack-photo">
        <Image
          src={advancement}
          alt="A Pack 170 den leader pins a rank badge on a Cub Scout's uniform at a pack meeting."
          widths={[420, 840]}
          width={840}
          height={1260}
          sizes="(max-width: 760px) 100vw, 42vw"
          loading="lazy"
        /><figcaption>A rank badge presented at a pack meeting · Shirley Hills, Macon</figcaption>
      </figure>
    </div>
  </section>
  <section class="section how-section">
    <div class="container">
      <div class="section-heading"><span class="chapter-tab">How the pack works</span><h2>Small dens. One whole pack.</h2></div><div
        class="how-flow"
      >
        <div><span>1</span><h3>Children join by grade</h3><p>A den is a small, same-grade Cub Scout group.</p></div><div>
          <span>2</span><h3>Dens choose a schedule</h3><p>Each den sets its own time and place; many meet before the pack gathering.</p>
        </div><div>
          <span>3</span><h3>Families gather as a pack</h3><p>Roughly once a month, everyone comes together at Highland Hills.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section promise-section">
    <div class="container promise-grid">
      <div class="paper-sheet promise">
        <span class="chapter-tab">Our approach</span><h2>Do your best.</h2><p class="lead">
          Cub Scouting meets children where they are. Adults make space to practice; kids build confidence by trying.
        </p>
      </div><div>
        <h2>Volunteer-powered, family-supported.</h2><p>
          Pack adults provide program, training, planning, and safety. Families bring encouragement, participation, and the willingness to
          help when they can.
        </p><a class="button button--blue" href="/volunteer/">See ways to help</a>
      </div>
    </div>
  </section>
  <section class="section roster-section">
    <div class="container">
      <span class="chapter-tab">Pack leadership</span>
      <figure class="pack-photo pack-photo--wide">
        <Image
          src={denLeader}
          alt="A Pack 170 den leader speaks from the podium at a pack meeting."
          widths={[640, 1280]}
          width={1280}
          height={853}
          sizes="(max-width: 760px) 100vw, 60rem"
          loading="lazy"
        /><figcaption>
          Every den is led by a registered adult who has cleared a background check and youth protection training. <a
            href="/youth-protection/">How that screening works</a
          >.
        </figcaption>
      </figure>
      <div class="roster"><Roster /></div>
    </div>
  </section>
  <section class="section council-section">
    <div class="container council-grid">
      <div>
        <span class="chapter-tab">Our Scouting home</span><h2>Part of something larger.</h2><p>
          Pack 170 is a unit of the Central Georgia Council, Scouting America. The council supports local units with training, program
          resources, camps, and the Macon Scout Shop.
        </p>
      </div><a class="button button--paper" href={pack.council.url} {...externalLink(pack.council.url)}>Visit the council website</a>
    </div>
  </section>
</BaseLayout>
<style>
  .story-grid,
  .promise-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .how-section {
    background: var(--page);
    border-block: 1px solid var(--rule);
  }
  .how-flow {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .how-flow div {
    padding: 2rem;
    border-top: 4px solid var(--blue);
    border-right: 1px dashed var(--rule);
  }
  .how-flow span {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-top: -3.7rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--gold);
    border: 4px solid var(--blue);
    font-family: var(--font-display);
    font-weight: 900;
  }
  .promise {
    padding: clamp(2rem, 5vw, 4rem);
    transform: rotate(-1deg);
  }
  .roster-section {
    background: var(--page);
    border-block: 1px solid var(--rule);
  }
  /* Photos sit in the same paper frame as the rest of the handbook, not edge-to-edge. */
  .pack-photo {
    margin: 0;
    padding: 0.75rem 0.75rem 0;
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  /* Both source photos are taller than the copy beside them, so they are cropped to a ratio rather
     than shown at full height — otherwise the portrait one runs about twice the paragraph's height. */
  .pack-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .pack-photo--wide img {
    aspect-ratio: 3 / 2;
  }
  .pack-photo figcaption {
    padding: 0.75rem 0.25rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .pack-photo--wide {
    max-width: 60rem;
    margin: 1.5rem 0 2.5rem;
  }
  /* Styles any structure the Markdown grows: h2 sections, prose, and role lists. */
  .roster :global(h2) {
    margin-top: 2.5rem;
  }
  .roster :global(h2:first-child) {
    margin-top: 0.5rem;
  }
  .roster :global(h3) {
    margin-top: 2rem;
  }
  .roster :global(p) {
    max-width: 65ch;
  }
  .roster :global(ul) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1rem 2rem;
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  .roster :global(li) {
    padding: 1rem 1.25rem;
    background: var(--paper);
    border-left: 4px solid var(--blue);
  }
  /* A role with no name yet reads as vacant rather than as a broken card. */
  .roster :global(li:empty) {
    display: none;
  }
  .roster :global(strong) {
    display: block;
    font-family: var(--font-display);
  }
  .council-section {
    background: var(--blue-deep);
    color: white;
  }
  .council-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
  }
  .council-grid p {
    max-width: 65ch;
  }
  @media (max-width: 760px) {
    .story-grid,
    .promise-grid,
    .council-grid {
      grid-template-columns: 1fr;
    }
    .how-flow {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .how-flow div {
      border-right: 0;
    }
    .promise {
      transform: none;
    }
  }
</style>
