---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterHero from '../../components/ChapterHero.astro';
import { pack } from '../../data/pack';
---

<BaseLayout title="Pack calendar" description="See what is next for Cub Scout Pack 170 and plan around the whole program year.">
  <ChapterHero
    chapter="Family planner"
    title="What’s next for"
    accent="Pack 170?"
    intro="This page answers one question fast: where does our family need to be, and when? Published event details are maintained by Pack 170 volunteers."
    noteTitle="Regular pack gathering"
    noteBody={`${pack.meeting.cadence} · ${pack.meeting.day}s at ${pack.meeting.time}`}
  >
    <div slot="actions" class="hero-actions">
      <a class="button button--gold" href="#published-events">See upcoming events</a><a class="button button--paper" href="/contact/"
        >Ask about a date</a
      >
    </div>
    <p slot="note">At {pack.meeting.location}. Den schedules vary.</p>
  </ChapterHero>

  <section class="section next-section" id="published-events">
    <div class="container">
      <div id="calendar-status" class="calendar-status" role="status">Loading the Pack 170 calendar…</div><div
        id="next-event"
        class="next-grid"
        hidden
      >
      </div><div id="event-list" class="event-cards"></div><noscript
        ><div class="notice">
          <span class="notice__pin">!</span><div>
            <h3>JavaScript is needed for live dates</h3><p>Please contact Pack 170 adults for the next confirmed event.</p>
          </div>
        </div></noscript
      >
    </div>
  </section>

  <section class="section calendar-help">
    <div class="container calendar-help__grid">
      <div>
        <span class="chapter-tab">Before you go</span><h2>Open the event before you load the car.</h2>
      </div><ul class="calendar-help__sheet">
        <li>
          <span class="calendar-help__mark" aria-hidden="true"></span><span
            >Open any event for the address, the start and end time, and what to wear or bring.</span
          >
        </li><li>
          <span class="calendar-help__mark" aria-hidden="true"></span><span
            >Each event is marked den, pack, or family, so you know who needs to be there.</span
          >
        </li><li>
          <span class="calendar-help__mark" aria-hidden="true"></span><span
            >Cost and registration show up on the event page whenever an event has either.</span
          >
        </li><li>
          <span class="calendar-help__mark" aria-hidden="true"></span><span
            >A location we’re still confirming says so. Check back before you drive over.</span
          >
        </li><li>
          <span class="calendar-help__mark" aria-hidden="true"></span><span
            >If a date moves or is called off, the event page carries the change.</span
          >
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container den-note paper-sheet">
      <div>
        <span class="chapter-tab">Den schedules</span><h2>Small groups choose their own rhythm.</h2><p>
          Dens set their own meeting times and locations. Many meet at the church for an hour before the pack meeting, but your den leader
          will confirm your family’s actual schedule.
        </p>
      </div><a class="button button--blue" href="/contact/">Find the right adult</a>
    </div>
  </section>
</BaseLayout>
<script>
  import { API_BASE } from '../../lib/api-base';
  type PublicEvent = {
    slug: string;
    title: string;
    summary: string;
    starts_at: string;
    ends_at: string | null;
    status: string;
    category: string;
    location_name: string | null;
    audience: string;
  };
  const status = document.querySelector<HTMLElement>('#calendar-status');
  const next = document.querySelector<HTMLElement>('#next-event');
  const list = document.querySelector<HTMLElement>('#event-list');
  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[character] ?? character,
    );
  const date = (value: string) =>
    new Intl.DateTimeFormat(undefined, { dateStyle: 'full', timeStyle: 'short', timeZone: 'America/New_York' }).format(new Date(value));
  async function loadCalendar() {
    try {
      const response = await fetch(`${API_BASE}/api/events`);
      if (!response.ok) throw new Error();
      const body = (await response.json()) as { events: PublicEvent[] };
      if (!body.events.length) {
        if (status)
          status.innerHTML =
            '<div class="notice"><span class="notice__pin">i</span><div><h3>No published dates yet</h3><p>Pack volunteers are preparing the calendar. Use the annual overview below and contact the pack before making a special trip.</p></div></div>';
        return;
      }
      if (status)
        status.textContent = `${body.events.length} upcoming event${body.events.length === 1 ? '' : 's'} · color-coded by who each event is for`;
      const first = body.events[0];
      if (next) {
        next.hidden = false;
        next.innerHTML = `<div><span class="chapter-tab">Next up</span><h2>${escapeHtml(first.title)}</h2><p class="lead">${escapeHtml(first.summary)}</p><a class="button button--blue" href="/events/?event=${encodeURIComponent(first.slug)}">Open event details</a></div><div class="date-sheet"><span>${date(first.starts_at)}</span><strong>${escapeHtml(first.location_name || 'Location being confirmed')}</strong><small>${escapeHtml(first.status)}</small></div>`;
      }
      if (list)
        list.innerHTML = body.events
          .slice(1)
          .map((event) => {
            // Only a state that changes a family's plans earns a chip; "scheduled" is the silent default.
            const flag = event.status.toLowerCase() === 'scheduled' ? '' : `<span class="event-status">${escapeHtml(event.status)}</span>`;
            return `<article data-category="${escapeHtml(event.category)}"><span class="event-cat">${escapeHtml(event.category)}</span>${flag}<span class="event-date">${date(event.starts_at)}</span><h3>${escapeHtml(event.title)}</h3><p>${escapeHtml(event.summary)}</p><a href="/events/?event=${encodeURIComponent(event.slug)}">Event details →</a></article>`;
          })
          .join('');
    } catch {
      if (status)
        status.innerHTML =
          '<div class="notice notice--editor"><span class="notice__pin">!</span><div><h3>Calendar unavailable</h3><p>We could not load live event data. Please try again or contact Pack 170 adults.</p></div></div>';
    }
  }
  loadCalendar();
</script>
<style>
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .calendar-status {
    margin-bottom: 2rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .next-grid,
  .calendar-help__grid {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .next-grid :global(.date-sheet) {
    display: grid;
    gap: 0.7rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--gold);
    color: var(--blue-deep);
    border-radius: 7px 20px 8px 7px;
    box-shadow: var(--shadow-paper);
    transform: rotate(1deg);
  }
  .next-grid :global(.date-sheet span) {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 900;
  }
  .next-grid :global(.date-sheet strong) {
    font-size: 1.15rem;
  }
  .next-grid :global(.date-sheet small) {
    text-transform: capitalize;
  }
  .event-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.15rem;
    margin-top: 3rem;
  }
  /* Category drives the accent: the Local Accent Rule wants colour to explain something. */
  .event-cards :global(article) {
    --cat: var(--blue);
    --cat-ink: var(--page);
    position: relative;
    padding: 1.5rem;
    background: var(--page);
    border: 1px solid var(--rule);
    border-radius: 6px 16px 8px 6px;
    box-shadow: var(--shadow-paper);
  }
  .event-cards :global(article[data-category='den']) {
    --cat: var(--green);
    --cat-ink: var(--page);
  }
  .event-cards :global(article[data-category='family']) {
    --cat: var(--orange);
    --cat-ink: var(--ink);
  }
  .event-cards :global(article)::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 8px;
    background: var(--cat);
    border-radius: 6px 16px 0 0;
    opacity: 0.77;
  }
  .event-cards :global(.event-cat) {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border-radius: 3px 9px 5px 3px;
    background: var(--cat);
    color: var(--cat-ink);
    margin-bottom: 0.9rem;
  }
  .event-cards :global(.event-status) {
    display: inline-block;
    margin: 0 0 0.9rem 0.4rem;
    padding: 0.3rem 0.6rem;
    border-radius: 3px 9px 5px 3px;
    background: var(--red);
    color: var(--page);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .event-cards :global(h3) {
    font-size: 1.15rem;
    margin: 0 0 0.35rem;
  }
  .event-cards :global(article p) {
    margin: 0 0 0.8rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .event-cards :global(article a) {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 800;
  }
  .event-cards :global(.event-date) {
    display: block;
    color: var(--blue);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 800;
    margin-bottom: 0.7rem;
  }
  .calendar-help {
    background: var(--green-deep);
    color: white;
  }
  .calendar-help .chapter-tab {
    color: var(--blue-deep);
  }
  .calendar-help h2 {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(2.05rem, 5vw, 3.5rem);
    text-wrap: balance;
  }
  /* The six logistics live on one hand-cut sheet laid over the green field, so the list reads
     as a checklist a parent could have been handed rather than a wall of running text. */
  .calendar-help__sheet {
    list-style: none;
    margin: 0;
    padding: clamp(1.1rem, 2.5vw, 1.75rem) clamp(1.25rem, 3vw, 2.25rem);
    background: var(--page);
    color: var(--ink);
    border-radius: 6px 20px 10px 8px;
    box-shadow:
      9px 11px 0 rgba(0, 0, 0, 0.2),
      0 20px 44px rgba(0, 0, 0, 0.22);
    transform: rotate(-1deg);
  }
  .calendar-help__sheet li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.85rem;
    align-items: start;
    padding: 0.85rem 0;
    border-top: 1px solid var(--rule);
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .calendar-help__sheet li:first-child {
    border-top: 0;
  }
  /* Pen tick drawn from two borders, so no font glyph is involved. */
  .calendar-help__mark {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05rem;
  }
  .calendar-help__mark::before {
    content: '';
    position: absolute;
    box-sizing: border-box;
    left: 0.15rem;
    top: 0.3rem;
    width: 0.95rem;
    height: 0.5rem;
    border-left: 3px solid var(--green-deep);
    border-bottom: 3px solid var(--green-deep);
    transform: rotate(-45deg);
  }
  .den-note {
    padding: clamp(2rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
  }
  @media (max-width: 760px) {
    .next-grid,
    .calendar-help__grid {
      grid-template-columns: 1fr;
    }
    .event-cards {
      grid-template-columns: 1fr;
    }
    .calendar-help__sheet {
      transform: none;
    }
    .den-note {
      grid-template-columns: 1fr;
    }
    .hero-actions .button {
      flex: 1;
    }
  }
</style>
