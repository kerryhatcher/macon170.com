---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterHero from '../../components/ChapterHero.astro';
import { annualProgram, events, pack } from '../../data/pack';
const today = new Date().toISOString().slice(0, 10);
const datedEvents = events
  .filter(event => event.date && event.date >= today && event.status !== 'cancelled')
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));
---
<BaseLayout title="Pack calendar" description="See what is next for Cub Scout Pack 170 and plan around the whole program year.">
  <ChapterHero chapter="Family planner" title="What’s next for" accent="Pack 170?" intro="This page is designed to answer one question fast: where does our family need to be, and when? Exact event dates will appear here as pack leadership supplies them." noteTitle="Regular pack gathering" noteBody={`${pack.meeting.cadence} · ${pack.meeting.day}s at ${pack.meeting.time}`}>
    <div slot="actions" class="hero-actions"><a class="button button--gold" href="#program-year">See the whole year</a><a class="button button--paper" href="/contact/">Ask about a date</a></div>
    <p slot="note">At {pack.meeting.location}. Den schedules vary.</p>
  </ChapterHero>

  <section class="section next-section"><div class="container next-grid"><div><span class="chapter-tab">Next up</span><h2>{datedEvents.length ? datedEvents[0].title : 'The next confirmed date is coming soon.'}</h2><p class="lead">{datedEvents.length ? datedEvents[0].summary : 'Pack leadership has not supplied this program year’s event dates yet. We are showing the known annual rhythm below without pretending those dates are confirmed.'}</p></div><div class="notice notice--editor"><span class="notice__pin">!</span><div><h3>Calendar is awaiting real dates</h3><p>Pack editor: add events in <code>src/data/pack.ts</code>. Visitors can still use the annual overview and known regular meeting information.</p></div></div></div></section>

  <section class="section planner-section" id="program-year"><div class="container"><div class="section-heading"><span class="chapter-tab">Fall to summer</span><h2>The Pack 170 year, laid open.</h2><p>These are recurring program anchors, not confirmed event dates. Each event will link to a logistics page after the date, time, and location are supplied.</p></div><ol class="planner">{annualProgram.map((item,index)=><li><span class="planner__month">{item.season}</span><span class="planner__number">{String(index+1).padStart(2,'0')}</span><div><h3>{item.title}</h3><p>{item.state}</p></div><span class="planner__status">Awaiting date</span></li>)}</ol></div></section>

  <section class="section calendar-help"><div class="container calendar-help__grid"><div><span class="chapter-tab">Reading the planner</span><h2>Every event page will carry the details parents actually need.</h2></div><ul><li>Date, start and end time</li><li>Exact location and arrival notes</li><li>Who the event is for</li><li>What to bring or wear</li><li>Registration and cost, when applicable</li><li>Cancellation or location-change status</li></ul></div></section>

  <section class="section"><div class="container den-note paper-sheet"><div><span class="chapter-tab">Den schedules</span><h2>Small groups choose their own rhythm.</h2><p>Dens set their own meeting times and locations. Many meet at the church for an hour before the pack meeting, but your den leader will confirm your family’s actual schedule.</p></div><a class="button button--blue" href="/contact/">Find the right adult</a></div></section>
</BaseLayout>
<style>
.hero-actions{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.5rem}.next-grid,.calendar-help__grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem);align-items:start}.planner-section{background:var(--page);border-block:1px solid var(--rule)}.planner{list-style:none;padding:0;margin:0;border-top:4px solid var(--blue)}.planner li{display:grid;grid-template-columns:120px 60px 1fr auto;gap:1rem;align-items:center;padding:1.25rem .5rem;border-bottom:1px solid var(--rule)}.planner__month{font-family:var(--font-display);font-weight:800;color:var(--blue)}.planner__number{font-family:var(--font-display);font-size:1.6rem;font-weight:900;color:#a6b4bf}.planner h3,.planner p{margin:0}.planner__status{font-size:.88rem;font-weight:700;color:var(--red);background:#fbe9e7;padding:.35rem .65rem;border-radius:4px 9px 4px 4px}.calendar-help{background:var(--green-deep);color:white}.calendar-help .chapter-tab{color:var(--blue-deep)}.calendar-help ul{columns:2;column-gap:2.5rem;margin:0;padding-left:1.2rem}.calendar-help li{break-inside:avoid;margin-bottom:.7rem}.den-note{padding:clamp(2rem,5vw,4rem);display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:center}code{font-size:.85em;background:rgba(255,255,255,.55);padding:.15em .3em}@media(max-width:760px){.next-grid,.calendar-help__grid{grid-template-columns:1fr}.planner li{grid-template-columns:90px 1fr}.planner__number{display:none}.planner__status{grid-column:2}.calendar-help ul{columns:1}.den-note{grid-template-columns:1fr}.hero-actions .button{flex:1}}
</style>
