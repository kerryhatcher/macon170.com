---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterHero from '../../components/ChapterHero.astro';
import { pack, annualProgram } from '../../data/pack';
---

<BaseLayout title="Pack calendar" description="See what is next for Cub Scout Pack 170 and plan around the whole program year.">
  <ChapterHero
    chapter="Family planner"
    title="What’s next for"
    accent="Pack 170?"
    intro="This page answers one question fast: where does our family need to be, and when? Published event details are maintained by Pack 170 volunteers."
    noteTitle="Regular pack gathering"
    noteBody={`${pack.meeting.cadence} · ${pack.meeting.day}s at ${pack.meeting.time}`}
  >
    <div slot="actions" class="hero-actions">
      <a class="button button--gold" href="#program-year">See the program year</a><a class="button button--paper" href="/contact/"
        >Ask about a date</a
      >
    </div>
    <p slot="note">At {pack.meeting.location}. Den schedules vary.</p>
  </ChapterHero>

  <section class="section next-section" id="program-year">
    <div class="container">
      <div class="section-heading">
        <span class="chapter-tab">The pack year</span><h2>Four milestones, and everything in between.</h2><p>
          The four milestones below are the shape of every Pack 170 year. Published dates fill in as volunteers schedule them, and other
          pack, den, and family dates land between them.
        </p>
      </div>

      {
        /* Server-rendered so the year is on the page before any fetch: a failed API leaves the spine
      standing rather than an empty column. The client merges published dates into this list. */
      }
      <ol class="timeline" id="timeline" data-pm-list>
        {
          annualProgram.map((item) => (
            <li class="timeline__row timeline__row--milestone" data-pm-row={item.key} data-season={item.season}>
              <span class="timeline__season">{item.season}</span>
              <strong class="timeline__title">{item.title}</strong>
              <small class="timeline__when" data-pm-when>
                {item.state}
              </small>
            </li>
          ))
        }
      </ol>
      <p class="timeline__note" data-pm-note>Checking the pack calendar for confirmed dates…</p>
      <div id="calendar-status" class="calendar-status" role="status" aria-live="polite"></div><div
        id="calendar-notice"
        class="calendar-notice"
      >
      </div>
    </div>
  </section>

  <section class="section calendar-help">
    <div class="container calendar-help__grid">
      <div>
        <span class="chapter-tab">Before you go</span><h2>Open the event before you load the car.</h2>
      </div><ul class="calendar-help__sheet">
        <li>
          <span class="calendar-help__mark" aria-hidden="true"></span><span
            >Open any event for the address, the start and end time, and what to wear or bring.</span
          >
        </li><li>
          <span class="calendar-help__mark" aria-hidden="true"></span><span
            >Each event is marked den, pack, or family, so you know who needs to be there.</span
          >
        </li><li>
          <span class="calendar-help__mark" aria-hidden="true"></span><span
            >Cost and registration show up on the event page whenever an event has either.</span
          >
        </li><li>
          <span class="calendar-help__mark" aria-hidden="true"></span><span
            >A location we’re still confirming says so. Check back before you drive over.</span
          >
        </li><li>
          <span class="calendar-help__mark" aria-hidden="true"></span><span
            >If a date moves or is called off, the event page carries the change.</span
          >
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container den-note paper-sheet">
      <div>
        <span class="chapter-tab">Den schedules</span><h2>Small groups choose their own rhythm.</h2><p>
          Dens set their own meeting times and locations. Many meet at the church for an hour before the pack meeting, but your den leader
          will confirm your family’s actual schedule.
        </p>
      </div><a class="button button--blue" href="/contact/">Find the right adult</a>
    </div>
  </section>
</BaseLayout>
<script>
  import { API_BASE } from '../../lib/api-base';
  import { annualProgram } from '../../data/pack';
  import { buildTimeline, monthKey, monthLabel, milestoneProgress, type SpineEvent } from '../../lib/pack-year';

  const timeline = document.querySelector<HTMLElement>('#timeline');
  const status = document.querySelector<HTMLElement>('#calendar-status');
  const notice = document.querySelector<HTMLElement>('#calendar-notice');
  const note = document.querySelector<HTMLElement>('[data-pm-note]');

  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[character] ?? character,
    );
  const dayLabel = (value: string) =>
    new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'short', month: 'short', day: 'numeric' }).format(
      new Date(value),
    );
  const timeLabel = (value: string) =>
    new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', timeStyle: 'short' }).format(new Date(value));

  function milestoneRow(entry: Extract<ReturnType<typeof buildTimeline>[number], { kind: 'milestone' }>): string {
    const { milestone, event, done } = entry;
    // No event yet: keep the honest placeholder the server already wrote rather than inventing a date.
    const when = event ? `${dayLabel(event.starts_at)} · ${timeLabel(event.starts_at)}` : milestone.state;
    const where = event?.location_name ? `<span class="timeline__where">${escapeHtml(event.location_name)}</span>` : '';
    const state = done ? '<span class="timeline__state">Held this year</span>' : '';
    const open = event ? `<a class="timeline__open" href="/events/?event=${encodeURIComponent(event.slug)}">Open event details</a>` : '';
    const flags = [event ? 'data-confirmed' : '', done ? 'data-done' : ''].filter(Boolean).join(' ');
    return `<li class="timeline__row timeline__row--milestone" data-pm-row="${escapeHtml(milestone.key)}" ${flags}>
      <span class="timeline__season">${escapeHtml(milestone.season)}</span>
      <strong class="timeline__title">${escapeHtml(event ? event.title : milestone.title)}</strong>
      <small class="timeline__when" data-pm-when>${escapeHtml(when)}</small>${where}${state}${open}
    </li>`;
  }

  function eventRow(event: SpineEvent): string {
    // Only a state that changes a family's plans earns a chip; "scheduled" is the silent default.
    const flag =
      (event.status ?? '').toLowerCase() === 'scheduled' ? '' : `<span class="event-status">${escapeHtml(event.status ?? '')}</span>`;
    const where = event.location_name ? `<span class="timeline__where">${escapeHtml(event.location_name)}</span>` : '';
    return `<li class="timeline__row timeline__row--event" data-category="${escapeHtml(event.category ?? 'pack')}">
      <span class="timeline__day">${dayLabel(event.starts_at)} · ${timeLabel(event.starts_at)}</span>
      <a class="timeline__title" href="/events/?event=${encodeURIComponent(event.slug)}">${escapeHtml(event.title)}</a>
      <span class="event-cat">${escapeHtml(event.category ?? 'pack')}</span>${flag}${where}
    </li>`;
  }

  function render(events: SpineEvent[]) {
    if (!timeline) return;
    const entries = buildTimeline(annualProgram, events);
    let month = '';
    const rows: string[] = [];
    for (const entry of entries) {
      const key = monthKey(entry.at);
      if (key !== month) {
        month = key;
        // An undated milestone sits in its nominal month, so the heading is a season marker for it.
        rows.push(`<li class="timeline__month"><h3>${escapeHtml(monthLabel(entry.at))}</h3></li>`);
      }
      rows.push(entry.kind === 'milestone' ? milestoneRow(entry) : eventRow(entry.event));
    }
    timeline.innerHTML = rows.join('');

    const progress = milestoneProgress(annualProgram, events);
    if (note)
      note.textContent = progress.confirmed
        ? `${progress.confirmed} of ${progress.total} milestones have a published date. The other ${progress.total - progress.confirmed} are still being scheduled by pack volunteers.`
        : 'No milestone dates are published yet. Pack volunteers are still scheduling the year.';

    const count = events.length;
    if (status)
      status.textContent = count
        ? `${count} published date${count === 1 ? '' : 's'} on the calendar, coloured by who each one is for.`
        : '';
  }

  async function loadCalendar() {
    try {
      const response = await fetch(`${API_BASE}/api/events`);
      if (!response.ok) throw new Error('events unavailable');
      const body = (await response.json()) as { events: SpineEvent[] };
      render(body.events);
      if (!body.events.length && notice)
        notice.innerHTML =
          '<div class="notice"><span class="notice__pin">i</span><div><h3>No dates are published yet</h3><p>Pack volunteers are still scheduling the year. The four milestones above are the shape it will take. <a href="/contact/">Ask a pack adult</a> before making a special trip.</p></div></div>';
    } catch {
      // The spine is already on the page, so a failed fetch loses the dates, not the year.
      if (notice)
        notice.innerHTML =
          '<div class="notice notice--editor"><span class="notice__pin">!</span><div><h3>We could not load live dates</h3><p>The four milestones above still show the shape of the year. Please try again, or <a href="/contact/">ask a pack adult</a> for the next confirmed date.</p></div></div>';
    }
  }

  loadCalendar();
</script>
<style>
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  /* The one-line count only. Body copy must never be injected here: the label ramp is uppercase
     0.76rem, which DESIGN.md reserves for chips and edition marks. Notices go in .calendar-notice. */
  .calendar-status {
    margin-top: 1.25rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .calendar-status:empty {
    margin: 0;
  }
  .calendar-notice:not(:empty) {
    margin-top: 1.5rem;
  }

  /* One date-ordered stream: milestone anchors carry the year's shape, ordinary dates sit between
     them, and a month heading opens each new month. A milestone with no date still holds its place
     from its nominal season, so the spine is intact before any date is entered. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .timeline :global(.timeline__month) {
    margin: 2rem 0 0.35rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
  }
  .timeline :global(.timeline__month:first-child) {
    margin-top: 0;
  }
  .timeline :global(.timeline__month h3) {
    margin: 0;
    font-size: 1.15rem;
    color: var(--blue-deep);
  }
  /* The rule that finishes the month heading, drawn rather than bordered onto a box. */
  .timeline :global(.timeline__month::after) {
    content: '';
    height: 2px;
    background: var(--rule);
  }
  .timeline :global(.timeline__row) {
    display: grid;
    gap: 0.15rem 0.9rem;
    padding: 0.85rem 1rem;
    background: var(--page);
    border: 1px solid var(--rule);
    border-radius: 5px 14px 7px 5px;
  }
  .timeline :global(.timeline__row--milestone) {
    --cat: var(--blue);
    grid-template-columns: 1fr auto;
    align-items: start;
    padding: 1.15rem 1.25rem;
    border: 2px dashed var(--rule);
    border-radius: 6px 18px 10px 6px;
  }
  /* A published milestone becomes a real sheet: solid edge, print shadow, lifted off the page. */
  .timeline :global(.timeline__row--milestone[data-confirmed]) {
    border-style: solid;
    border-color: var(--blue);
    box-shadow: var(--shadow-paper);
  }
  .timeline :global(.timeline__row--milestone[data-done]) {
    border-color: var(--rule);
    box-shadow: none;
    background: var(--paper);
  }
  .timeline :global(.timeline__season) {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .timeline :global(.timeline__row--milestone[data-confirmed] .timeline__season) {
    color: var(--blue);
  }
  .timeline :global(.timeline__row--milestone .timeline__title) {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--blue-deep);
  }
  .timeline :global(.timeline__when) {
    grid-column: 1;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .timeline :global(.timeline__row--milestone[data-confirmed] .timeline__when) {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--blue);
  }
  .timeline :global(.timeline__where) {
    grid-column: 1;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .timeline :global(.timeline__state) {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    padding: 0.3rem 0.6rem;
    border-radius: 3px 9px 5px 3px;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .timeline :global(.timeline__open) {
    grid-column: 1;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 800;
  }
  /* Ordinary dates: a quieter row, category on the right, so the milestones stay the loud thing. */
  .timeline :global(.timeline__row--event) {
    grid-template-columns: 1fr auto;
    align-items: center;
  }
  .timeline :global(.timeline__row--event[data-category='den']) {
    --cat: var(--green);
  }
  .timeline :global(.timeline__row--event[data-category='family']) {
    --cat: var(--orange);
  }
  .timeline :global(.timeline__day) {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--blue);
  }
  .timeline :global(.timeline__row--event .timeline__title) {
    grid-column: 1;
    font-size: 1.1rem;
    font-weight: 700;
  }
  .timeline :global(.timeline__row--event .event-cat) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    display: inline-block;
    padding: 0.3rem 0.6rem;
    border-radius: 3px 9px 5px 3px;
    background: var(--cat, var(--blue));
    color: var(--page);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .timeline :global(.timeline__row--event[data-category='family'] .event-cat) {
    color: var(--ink);
  }
  .timeline :global(.timeline__row--event .event-status) {
    grid-column: 1;
    justify-self: start;
    padding: 0.3rem 0.6rem;
    border-radius: 3px 9px 5px 3px;
    background: var(--red);
    color: var(--page);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* Server-rendered sibling of .timeline, so it keeps its scope attribute and needs no :global. */
  .timeline__note {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .calendar-help__grid {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .calendar-help {
    background: var(--green-deep);
    color: white;
  }
  .calendar-help .chapter-tab {
    color: var(--blue-deep);
  }
  .calendar-help h2 {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(2.05rem, 5vw, 3.5rem);
    text-wrap: balance;
  }
  /* The six logistics live on one hand-cut sheet laid over the green field, so the list reads
     as a checklist a parent could have been handed rather than a wall of running text. */
  .calendar-help__sheet {
    list-style: none;
    margin: 0;
    padding: clamp(1.1rem, 2.5vw, 1.75rem) clamp(1.25rem, 3vw, 2.25rem);
    background: var(--page);
    color: var(--ink);
    border-radius: 6px 20px 10px 8px;
    box-shadow:
      9px 11px 0 rgba(0, 0, 0, 0.2),
      0 20px 44px rgba(0, 0, 0, 0.22);
    transform: rotate(-1deg);
  }
  .calendar-help__sheet li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.85rem;
    align-items: start;
    padding: 0.85rem 0;
    border-top: 1px solid var(--rule);
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .calendar-help__sheet li:first-child {
    border-top: 0;
  }
  /* Pen tick drawn from two borders, so no font glyph is involved. */
  .calendar-help__mark {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05rem;
  }
  .calendar-help__mark::before {
    content: '';
    position: absolute;
    box-sizing: border-box;
    left: 0.15rem;
    top: 0.3rem;
    width: 0.95rem;
    height: 0.5rem;
    border-left: 3px solid var(--green-deep);
    border-bottom: 3px solid var(--green-deep);
    transform: rotate(-45deg);
  }
  .den-note {
    padding: clamp(2rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
  }
  @media (max-width: 760px) {
    .calendar-help__grid {
      grid-template-columns: 1fr;
    }
    /* The timeline is already one column; only the category chip needs to stop competing
       with the title for width on a narrow screen. */
    .timeline :global(.timeline__row--event) {
      grid-template-columns: 1fr;
    }
    .timeline :global(.timeline__row--event .event-cat) {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
      margin-top: 0.35rem;
    }
    .calendar-help__sheet {
      transform: none;
    }
    .den-note {
      grid-template-columns: 1fr;
    }
    .hero-actions .button {
      flex: 1;
    }
  }
</style>
