---
/*
THESIS: Pack 170 is the elementary adventure handbook a child brings home and a parent keeps; it refuses the generic photo-hero/card-grid pack template.
OWN-WORLD: Cub blue and gold cover fields, warm notebook pages, sewn labels, bookmark tabs, original Macon field illustration, and grade-color markers.
STORY: A new family and a current family choose equally clear paths, share the same verified meeting truth, then see the grades, adventures, and program year.
FIRST VIEWPORT: A handbook-cover split with the title and meeting facts left, two oversized audience bookmarks right, and Calendar/Join actions at equal scale.
FORM: Handbook-cover index fused with children’s chapter-book warmth; selected from the user’s approved 04/07 concepts.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import FieldIllustration from '../components/FieldIllustration.astro';
import RankEmblem from '../components/RankEmblem.astro';
import { annualProgram, pack, ranks } from '../data/pack';
import { API_BASE } from '../lib/api-base';
---

<BaseLayout
  title="Macon’s neighborhood Cub Scout pack"
  description="Cub Scout Pack 170 welcomes boys and girls in kindergarten through 5th grade. We meet Tuesdays at 6:30 PM at Highland Hills Baptist Church in Macon."
>
  <section class="cover">
    <div class="container cover__grid">
      <div class="cover__copy">
        <span class="cover__edition">Macon family edition · Shirley Hills</span>
        <p class="cover__overline">The Elementary Adventure Handbook</p>
        <h1>Cub Scout<br /><span>Pack 170</span></h1>
        <p class="cover__promise">Build confidence. Find friends. Get outside. Do your best.</p>
        <dl class="cover__facts">
          <div><dt>Who</dt><dd>{pack.grades} · {pack.welcome}</dd></div>
          <div><dt>When</dt><dd>Roughly monthly · {pack.meeting.day}s at {pack.meeting.time}</dd></div>
          <div><dt>Where</dt><dd>{pack.meeting.location}</dd></div>
        </dl>
      </div>
      <div class="audience-index" aria-label="Choose your path">
        <a class="bookmark bookmark--join" href="/join/">
          <span class="bookmark__label">New to Pack 170?</span>
          <strong>Plan a first visit</strong>
          <span>What to expect, who can join, and how to begin →</span>
        </a>
        <a class="bookmark bookmark--calendar" href="/calendar/">
          <span class="bookmark__label">Pack families</span>
          <strong>See what’s next</strong>
          <span>Events, dates, details, and the whole program year →</span>
        </a>
        <div class="pencil-note">
          <strong>Good to know:</strong> Dens choose their own schedules. Many gather at the church for an hour before the pack meeting.
        </div>
      </div>
    </div>
    <div class="cover__binding" aria-hidden="true"></div>
  </section>

  <section class="section welcome">
    <div class="container welcome__grid">
      <div>
        <span class="chapter-tab">Start here</span>
        <h2>One pack. Six grades. A lot to discover.</h2>
        <p class="lead">
          Pack 170 is a volunteer-run Cub Scout pack in Macon’s Shirley Hills neighborhood. Kids learn by building, exploring, helping, and
          trying things that once felt hard—with their families beside them.
        </p>
        <p>
          We welcome boys and girls in kindergarten through 5th grade, from every background. You do not need to attend Highland Hills
          Baptist Church to join us.
        </p>
        <a class="button button--blue" href="/about/">Meet our pack</a>
      </div>
      <FieldIllustration />
    </div>
  </section>

  <section class="section grade-section">
    <div class="container">
      <div class="section-heading">
        <span class="chapter-tab">Find your place</span>
        <h2>There’s a den for every elementary grade.</h2>
        <p>
          Each rank meets children where they are. The names change by grade; the goal stays the same: grow through age-appropriate
          adventures.
        </p>
      </div>
      <div class="rank-path">
        {
          ranks.map((rank) => (
            <div class:list={['rank', `rank--${rank.color}`]}>
              <RankEmblem emblem={rank.emblem} name={rank.name} />
              <>
                <strong>{rank.name}</strong>
                <small>{rank.grade}</small>
              </>
            </div>
          ))
        }
      </div>
      <p class="grade-note">
        Pack 170 runs all six dens. Each den sets its own meeting schedule after the first pack meeting of the school year.
        <a href="/dens/">See what each den works on</a>.
      </p>
    </div>
  </section>

  <section class="section adventure-spread">
    <div class="container adventure-spread__grid">
      <div class="adventure-art" role="img" aria-label="Illustrated wooden race car crossing a finish line beneath Georgia pines">
        <div class="adventure-art__sun"></div><div class="adventure-art__pine pine-1">▲</div><div class="adventure-art__pine pine-2">▲</div>
        <div class="adventure-art__track"></div><div class="adventure-art__car">170</div><div class="adventure-art__flag">■<br />■</div>
      </div>
      <div class="adventure-copy">
        <span class="chapter-tab">What we do</span>
        <h2>Small hands. Big adventures.</h2>
        <p class="lead">
          Race a Pinewood Derby car. Spend a night under Georgia pines. Celebrate at Blue & Gold. Help the neighborhood. Every chapter gives
          kids a new way to say, “I did it.”
        </p>
        <a class="button button--gold" href="/activities/">Open the adventure chapters</a>
      </div>
    </div>
  </section>

  <section class="section year-section">
    <div class="container">
      <div class="section-heading">
        <span class="chapter-tab">The pack year</span>
        <h2>Six milestones, one program year.</h2>
        <p>
          Each card is a milestone in the order it arrives. A solid, lifted card means the date is published on the pack calendar; a dashed
          one is still being scheduled.
        </p>
      </div>
      <ol class="pm-strip" data-pm-list>
        {
          annualProgram.map((item) => (
            <li class="pm-cell" data-pm-row={item.title}>
              <span class="pm-month">{item.season}</span>
              <strong>{item.title}</strong>
              <small data-pm-when>{item.state}</small>
            </li>
          ))
        }
      </ol>
      <p class="pm-note" data-pm-note>Checking the pack calendar for confirmed dates…</p>
      <div class="year-actions">
        <a class="button button--blue" href="/calendar/">Open family calendar</a>
        <a class="button button--plain" href="/volunteer/">Lend a hand this year</a>
      </div>
    </div>
  </section>

  <section class="section closing">
    <div class="container closing__sheet paper-sheet">
      <div>
        <span class="chapter-tab">Your next page</span>
        <h2>Come see Pack 170 for yourself.</h2>
        <p class="lead">
          A first visit is simply a chance for your family to look around, meet pack adults, and decide whether Cub Scouting feels right.
        </p>
      </div>
      <div class="closing__actions">
        <a class="button button--gold" href="/join/">Plan a first visit</a>
        <a class="button button--paper" href="/contact/">Ask a parent question</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ pmProgram: annualProgram, pmApiBase: API_BASE }}>
  (function () {
    const root = document.querySelector('.year-section');
    if (!root) return;
    const fmt = (iso) => new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeZone: 'America/New_York' }).format(new Date(iso));

    // Keywords alone would let an August "Lego Pinewood Derby" fill the late-January
    // Derby milestone, so a match must also land in a plausible month.
    function matchFor(milestone, events) {
      return (
        events.find(function (event) {
          const title = String(event.title || '').toLowerCase();
          const month = new Date(event.starts_at).getMonth();
          return milestone.match.keywords.some((word) => title.includes(word)) && milestone.match.months.indexOf(month) !== -1;
        }) || null
      );
    }

    function paint(events) {
      let confirmed = 0;
      pmProgram.forEach(function (milestone) {
        const hit = matchFor(milestone, events);
        if (hit) confirmed += 1;
        root.querySelectorAll('[data-pm-row="' + CSS.escape(milestone.title) + '"]').forEach(function (cell) {
          const when = cell.querySelector('[data-pm-when]');
          if (!when) return;
          if (hit) {
            cell.setAttribute('data-confirmed', '');
            when.textContent = fmt(hit.starts_at);
          } else {
            cell.removeAttribute('data-confirmed');
            when.textContent = milestone.state;
          }
        });
      });
      const note = root.querySelector('[data-pm-note]');
      if (!note) return;
      note.textContent = confirmed
        ? confirmed +
          ' of ' +
          pmProgram.length +
          ' milestones have a published date. The other ' +
          (pmProgram.length - confirmed) +
          ' are still being scheduled by pack volunteers.'
        : 'No milestone dates are published yet. Pack volunteers are still scheduling the year.';
    }

    fetch(pmApiBase + '/api/events')
      .then(function (response) {
        if (!response.ok) throw new Error('events unavailable');
        return response.json();
      })
      .then(function (body) {
        paint(Array.isArray(body.events) ? body.events : []);
      })
      .catch(function () {
        // Leave the server-rendered placeholders untouched; never invent a date.
        const note = root.querySelector('[data-pm-note]');
        if (note) note.textContent = 'Live dates could not be loaded. The pack calendar has the confirmed schedule.';
      });
  })();
</script>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    min-height: min(760px, calc(100vh - 158px));
    display: grid;
    align-items: center;
    background: var(--blue);
    color: white;
    border-bottom: 10px solid var(--gold);
  }
  .cover::before {
    content: '';
    position: absolute;
    inset: 1.25rem;
    border: 2px solid rgba(252, 209, 22, 0.42);
    border-radius: 4px 30px 14px 8px;
    pointer-events: none;
  }
  .cover__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(330px, 0.92fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(5rem, 11vw, 9rem);
    position: relative;
    z-index: 1;
  }
  .cover__copy {
    max-width: 660px;
  }
  .cover__edition {
    position: absolute;
    top: 2.1rem;
    left: 0;
    font-family: var(--font-display);
    font-size: 0.73rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--blue-soft);
  }
  .cover__overline {
    color: var(--gold);
    font-family: var(--font-display);
    font-weight: 800;
    margin: 0 0 1rem;
  }
  .cover h1 span {
    color: var(--gold);
  }
  .cover__promise {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    font-weight: 700;
    max-width: 34ch;
  }
  .cover__facts {
    margin: 2rem 0 0;
    display: grid;
    gap: 0.55rem;
  }
  .cover__facts div {
    display: grid;
    grid-template-columns: 68px 1fr;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    padding: 0.55rem 0;
  }
  .cover__facts dt {
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .cover__facts dd {
    margin: 0;
    font-weight: 600;
  }
  .audience-index {
    display: grid;
    gap: 1rem;
  }
  .bookmark {
    position: relative;
    display: block;
    color: var(--blue-deep);
    padding: 1.25rem 1.5rem 1.45rem;
    text-decoration: none;
    border-radius: 7px 18px 6px 7px;
    box-shadow:
      7px 8px 0 rgba(0, 43, 92, 0.72),
      0 18px 35px rgba(0, 0, 0, 0.22);
    transition: transform 0.28s var(--ease);
  }
  @media (hover: hover) {
    .bookmark:hover {
      color: var(--blue-deep);
      transform: translate(-5px, -4px) rotate(-0.5deg);
    }
  }
  .bookmark::after {
    content: '';
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, transparent 50%, rgba(0, 43, 92, 0.2) 51%);
  }
  .bookmark--join {
    background: var(--gold);
    transform: rotate(-1deg);
  }
  .bookmark--calendar {
    background: var(--page);
    transform: rotate(1deg);
  }
  .bookmark__label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .bookmark strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2rem);
    margin: 0.2rem 0;
  }
  .bookmark span:last-child {
    display: block;
    line-height: 1.4;
  }
  .pencil-note {
    color: var(--blue-soft);
    font-size: 0.95rem;
    padding: 0.7rem 1.2rem;
    transform: rotate(-1deg);
    border-bottom: 1px dashed var(--blue-dim);
  }
  .cover__binding {
    position: absolute;
    width: 22px;
    top: 0;
    bottom: 0;
    left: 50%;
    opacity: 0.25;
    background: repeating-linear-gradient(0deg, transparent 0 26px, var(--gold) 27px 32px, transparent 33px 48px);
  }
  .welcome__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }
  .grade-section {
    background: var(--page);
    border-block: 1px solid var(--rule);
  }
  .grade-note {
    margin-top: 2rem;
    color: var(--muted);
    text-align: center;
  }
  .adventure-spread {
    background: var(--green-deep);
    color: white;
    overflow: hidden;
  }
  .adventure-spread__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .adventure-copy .lead {
    color: var(--green-soft);
  }
  .adventure-art {
    min-height: 430px;
    position: relative;
    border: 4px solid var(--page);
    background: #bfe0ec;
    overflow: hidden;
    border-radius: 50% 50% 10% 10% / 22% 22% 8% 8%;
  }
  .adventure-art__sun {
    position: absolute;
    width: 80px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--gold);
    top: 45px;
    right: 16%;
  }
  .adventure-art__pine {
    position: absolute;
    color: var(--green);
    font-size: 12rem;
    bottom: 18%;
    line-height: 1;
  }
  .pine-1 {
    left: 4%;
  }
  .pine-2 {
    right: 2%;
    transform: scale(0.78);
  }
  .adventure-art__track {
    position: absolute;
    height: 110px;
    left: -10%;
    right: -10%;
    bottom: 5%;
    background: #a06b3f;
    transform: rotate(-4deg);
    border-block: 8px solid #82502b;
  }
  .adventure-art__car {
    position: absolute;
    left: 32%;
    bottom: 22%;
    width: 150px;
    height: 65px;
    border-radius: 55px 20px 14px 14px;
    display: grid;
    place-items: center;
    background: var(--red);
    border: 5px solid var(--blue-deep);
    color: white;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.4rem;
    transform: rotate(-4deg);
    box-shadow:
      -25px 42px 0 -17px var(--blue-deep),
      54px 42px 0 -17px var(--blue-deep);
  }
  .adventure-art__flag {
    position: absolute;
    right: 17%;
    bottom: 35%;
    color: var(--ink);
    font-size: 2rem;
    line-height: 0.8;
    transform: rotate(10deg);
  }
  .year-line {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-top: 5px solid var(--blue);
  }
  .year-line li {
    position: relative;
    padding: 1.5rem 0.75rem 1rem;
    border-right: 1px dashed var(--rule);
  }
  .year-line li::before {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--gold);
    border: 4px solid var(--blue);
    top: -12px;
    left: 0.75rem;
  }
  .year-line span,
  .year-line strong,
  .year-line small {
    display: block;
  }
  .year-line span {
    color: var(--blue);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .year-line strong {
    line-height: 1.25;
    margin: 0.35rem 0;
  }
  .year-line small {
    color: var(--red);
    line-height: 1.25;
  }
  .year-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .closing {
    background: var(--blue-soft);
  }
  .closing__sheet {
    padding: clamp(2rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
  }
  .closing__actions {
    display: grid;
    gap: 0.8rem;
  }
  @media (max-width: 900px) {
    .cover__grid,
    .welcome__grid,
    .adventure-spread__grid {
      grid-template-columns: 1fr;
    }
    .cover__binding {
      display: none;
    }
    .year-line {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 2rem;
    }
    .closing__sheet {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .cover {
      min-height: auto;
    }
    .cover::before {
      inset: 0.6rem;
    }
    .cover__edition {
      top: 1rem;
      left: 0.5rem;
    }
    .cover__grid {
      padding-block: 4.5rem 3.5rem;
    }
    .year-line {
      grid-template-columns: repeat(2, 1fr);
    }
    .year-actions {
      display: grid;
    }
    .adventure-art {
      min-height: 330px;
    }
    .adventure-art__car {
      left: 22%;
    }
  }
  /* Pack-year milestones. State is carried by stroke style and depth rather than a
     coloured side-tab: a published date reads as a real lifted sheet, a pending one as
     a provisional dashed note. */
  .pm-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
  }
  .pm-cell {
    padding: 0.9rem 0.7rem;
    background: var(--page);
    border: 1px dashed var(--rule);
    border-radius: 6px 16px 8px 6px;
    min-height: 7.5rem;
  }
  .pm-cell[data-confirmed] {
    border-style: solid;
    box-shadow: var(--shadow-paper);
  }
  .pm-month {
    display: block;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .pm-cell[data-confirmed] .pm-month {
    color: var(--blue);
  }
  .pm-cell strong {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    display: block;
  }
  .pm-cell small {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .pm-cell[data-confirmed] small {
    color: var(--blue);
    font-family: var(--font-display);
    font-weight: 800;
  }
  .pm-note {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 760px) {
    .pm-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* A landscape phone is 844px wide and 390px tall, so it trips the width breakpoints above
     and stacks the cover into a single column roughly three screens deep — the parent who
     turned the phone sideways sees nothing but the blue field. Landscape is short on height,
     not width, so the columns come back and the vertical padding goes away. Declared last so
     it wins over the width queries above. */
  @media (orientation: landscape) and (max-height: 500px) {
    .cover {
      min-height: 0;
    }
    .cover__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(260px, 0.92fr);
      gap: 2rem;
      padding-block: 2rem;
    }
    .cover__facts {
      margin-top: 1rem;
    }
    .welcome__grid,
    .adventure-spread__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
