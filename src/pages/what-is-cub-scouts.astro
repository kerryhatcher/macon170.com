---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterHero from '../components/ChapterHero.astro';
import { pack, ranks } from '../data/pack';
import { externalLink } from '../lib/external-link';

const aims = [
  ['Character development', 'Practicing honesty, respect, and responsibility in a small group with adult guidance.'],
  ['Citizenship training', 'Learning civic habits — flag ceremonies, service projects, caring for the neighborhood.'],
  ['Personal fitness', 'Age-appropriate physical activity built into meetings and outdoor events.'],
  ['Leadership development', 'Kids take turns leading parts of a meeting, in a structure sized for their age.'],
];

// Verified against docs/research/bcsd/notes/strategic-plan.md — the district's own plan page.
const planUrl = 'https://www.bcsdk12.net/about-us/strategic-plan';

// What a rank's advancement actually asks a child to practice, in SEL terms. Keyed by rank name
// so a rank without a note simply renders without one. Every claim here is either the six
// required-Adventure areas that apply at every rank or a rank specific verified in
// docs/research/cub-scouting.md (Lion's adult partner, Webelos' 20 electives, Arrow of Light as
// crossover prep). No Adventure is named: many were retired or renamed in June 2024, and Bear's
// verified knife-safety Adventure was deliberately dropped as the wrong note for a page pitched
// at school leaders.
const selNotes: Record<string, string> = {
  Lion: 'An adult partner is in the den for every Lion meeting, so a five-year-old practices the first group skills — waiting a turn, sharing an adult’s attention — with their own grown-up beside them.',
  Tiger:
    'Den meetings run to a routine: an opening, a job to do, a closing. A first grader learns to name what they need and ask for help inside a structure that does not change week to week.',
  Wolf: 'Character & Leadership is one of the six Adventures every rank requires. For a second grader that means working with the partner they were given rather than the one they wanted, and finishing the part they agreed to do.',
  Bear: 'The required Citizenship Adventure puts a third grader on a service project — work whose benefit goes to people they will never meet.',
  Webelos:
    'Webelos choose from twenty elective Adventures. Picking one, planning it, and carrying it through is goal-setting a fourth grader owns rather than receives.',
  'Arrow of Light':
    'The fifth-grade program is built around the crossover to Scouts BSA: leading parts of a meeting for the younger dens, then handing the job to whoever comes next.',
};

const asks = [
  ['A table at an open house or family night', 'One table, one hour, staffed by adults who are already approved district volunteers.'],
  ['A few minutes on a PTO agenda', 'Optional, and short. Three minutes is plenty.'],
  ['Permission to post a flyer', 'On a bulletin board or in a newsletter, sized however the school prefers.'],
];
---

<BaseLayout
  title="What is Cub Scouting?"
  description="A plain-language overview of Cub Scouting and Pack 170 for school leaders, PTA/PTO boards, and community partners."
>
  <ChapterHero
    chapter="For school & community leaders"
    title="What is"
    accent="Cub Scouting?"
    intro="A plain-language briefing for administrators, executives, and civic leaders: what the program is, how it is run and supervised, and where it lines up with goals schools are already working on."
    noteTitle="The short version"
    noteBody={`${pack.grades} · ${pack.welcome}`}
    ><p slot="note">A local, volunteer-run program of Scouting America — not a sales pitch, not a fundraiser at the door.</p></ChapterHero
  >

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="chapter-tab">The program</span>
        <h2>A structured after-school activity, run by trained, background-checked parent volunteers.</h2>
      </div>
      <p>
        Cub Scouting is a program of Scouting America for children in {pack.grades}. {pack.welcome}. Kids meet in small, same-grade groups
        called dens, and the whole pack gathers periodically for a larger meeting. Every adult who runs a meeting is a registered, trained
        volunteer. Every child in Scouting must be escorted by their parent or guardian at every event — there is never a time at a Cub
        Scout event where a child's parent or guardian is not present.
      </p>
      <p>
        The six grade levels each carry a rank name, so a program built for a kindergartner looks and feels different from one built for a
        fifth grader. Social-Emotional Learning is at the core of each program:
      </p>
      <ul class="rank-list">
        {
          ranks.map((rank) => (
            <li>
              <p class="rank-list__name">
                <strong>{rank.name}</strong> — {rank.grade}
              </p>
              {selNotes[rank.name] && <p class="rank-list__note">{selNotes[rank.name]}</p>}
            </li>
          ))
        }
      </ul>
      <div class="plan-slab">
        <h2 class="plan-slab__head">Building stakeholder engagement</h2>
        <p class="plan-slab__source">
          Bibb County School District · <a href={planUrl} {...externalLink(planUrl)}>2023–2028 strategic plan</a>
        </p>
        <p class="plan-slab__quote">
          <q
            >if we build stakeholder engagement of students, parents staff and community, and strengthen staff effectiveness to drive
            teaching and learning, we will maximize student achievement.</q
          >
        </p>
        <p class="plan-slab__answer">
          A Cub Scout pack can help meet that goal, with a standing, year-round reason for families to be engaged — organized and paid for
          by its members.
        </p>
      </div>
    </div>
  </section>

  <section class="section aims-section">
    <div class="container">
      <div class="section-heading">
        <span class="chapter-tab">Why schools partner with us</span>
        <h2>Four aims a school can get behind.</h2>
      </div>
      <p class="lead">
        Cub Scouting is organized around four aims that line up with what schools already work on: character, citizenship, fitness, and
        leadership. Kids learn by doing, families stay involved, and the program is built around consistent attendance rather than tryouts
        or cuts.
      </p>
      <div class="aims-grid">
        {
          aims.map(([title, body]) => (
            <article>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section align-section">
    <div class="container">
      <div class="section-heading">
        <span class="chapter-tab">Complementing the plan</span>
        <h2>Where this lines up with what schools are already working on.</h2>
      </div>
      <div class="align-rows">
        <section class="align-row">
          <h3>Engaged families, already vetted</h3>
          <div>
            <p>
              Every Cub Scout is enrolled by an adult, and the pack only runs because those adults take registered roles — den leader,
              treasurer, event coordinator, driver. Each one is trained and passes a criminal background check.
            </p>
            <p>
              Many of our adults are already approved Bibb County school volunteers. A pack does not draw down a school's volunteer
              capacity. It draws on adults who are already in the habit of showing up for their own children.
            </p>
          </div>
        </section>
        <section class="align-row">
          <h3>Practice in the skills behind SEL</h3>
          <div>
            <p>
              We are not a curriculum and we do not replace one. What a den gives a child is repeated practice in a small, same-grade group:
              taking a turn leading, working with a partner who was not their first choice, finishing something difficult, and being
              accountable to other kids for it.
            </p>
            <p>
              The five competencies the district plan's SEL objective draws on — self-awareness, self-management, social awareness,
              relationship skills, responsible decision-making — are the ordinary business of a den meeting rather than a unit we teach.
            </p>
          </div>
        </section>
        <section class="align-row">
          <h3>One more adult who knows the child</h3>
          <div>
            <p>
              Research on school connectedness consistently finds that a stable relationship with a caring adult is protective for children.
              A den leader is one of those adults: the same eight or ten kids, month after month, for years, and a standing reason to talk
              to their parents.
            </p>
            <p>
              Multi-tiered supports depend on someone noticing a child early. Having more adults who know a child well, outside the school
              day, is not a bad thing.
            </p>
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="section who-section">
    <div class="container who-grid">
      <div>
        <span class="chapter-tab">Who we are</span>
        <h2>Pack 170, specifically.</h2>
        <p>
          {pack.name} is Macon's local Cub Scout pack, part of the {pack.council.name} of Scouting America. We're chartered by <a
            href={pack.charteredOrganization.url}
            {...externalLink(pack.charteredOrganization.url)}>{pack.charteredOrganization.name}</a
          >, where the pack meets. The pack is entirely volunteer-run — there is no paid staff.
        </p>
        <p>
          Pack meetings happen {pack.meeting.cadence.toLowerCase()} on {pack.meeting.day}s at {pack.meeting.time}, at{' '}
          {pack.meeting.location}. Families do not need any connection to the chartering church to join.
        </p>
      </div>
      <div class="ask-slip">
        <span class="chapter-tab ask-slip__tab">What we would ask of a school</span>
        <h3>A table, and that is about it.</h3>
        <ul class="ask-checklist">
          {
            asks.map(([title, body]) => (
              <li>
                <span class="ask-tick" aria-hidden="true" />
                <div>
                  <strong>{title}</strong>
                  <p>{body}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="ask-slip__note">That is the whole list. No room, no budget, no staff time.</p>
      </div>
    </div>
  </section>

  <section class="section safety-section">
    <div class="container">
      <div class="notice">
        <span class="notice__pin">✓</span>
        <div>
          <h3>Youth protection, at a glance</h3>
          <p>
            Every registered adult completes Scouting America's Safeguarding Youth Training before serving with youth, and renews it every
            year. Every registered adult passes a criminal background check. Two-deep leadership means at least two registered adults are
            present at every activity, and one-on-one contact between an adult and a youth is prohibited. Every part of the program is open
            to observation by parents at any time. Suspected abuse is reported to law enforcement — this is never handled internally.
            Nothing on this website is members-only, and every contact channel reaches multiple adults.
          </p>
          <p>
            Scouting America's national general liability program covers chartered units, so a school hosting our table is not underwriting
            our coverage. We can provide a certificate, our training records, and the names of the adults who would staff the table, before
            anyone asks for them.
          </p>
          <p><a href="/youth-protection/">Read the full youth protection standards →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container close-grid paper-sheet">
      <div>
        <h2>Invite Pack 170 to a family night.</h2>
        <p>
          When a school has an open house, a family night, or a few minutes on a PTO agenda, Pack 170 would like to be there. The pack
          brings the table, the adults, and the paperwork.
        </p>
      </div>
      <a class="button button--blue" href="/contact/">Ask about a table</a>
    </div>
  </section>

  <section class="join-signpost">
    <div class="container join-signpost__inner">
      <p>Looking to enroll your own child instead?</p>
      <a class="button button--paper" href="/join/">See how to join Pack 170</a>
    </div>
  </section>
</BaseLayout>
<style>
  /* Two columns, not three: each rank now carries a sentence, and a third column would squeeze
     the measure below readable. */
  .rank-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .rank-list li {
    padding: 0.6rem 0.9rem;
    background: var(--page);
    border-left: 4px solid var(--blue);
  }
  .rank-list__name {
    margin: 0;
  }
  .rank-list__note {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .rank-list {
      grid-template-columns: 1fr;
    }
  }
  .aims-section {
    background: var(--page);
    border-block: 1px solid var(--rule);
  }
  .aims-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .aims-grid article {
    padding: 1.25rem;
    background: var(--page);
    border-top: 5px solid var(--gold);
    box-shadow: 3px 5px 0 var(--rule);
  }
  /* "Who we are" opens a new chapter directly after the align rows, and two prose sections on
     the same warm paper ran together with nothing marking the cut. A river-green field carries
     it — DESIGN.md's role for practical guidance — with a gold rule at the top edge as the
     break. Light green, not the deep tone: .safety-section below is already midnight blue, and
     two dark fields in a row would merge into one band instead of reading as two chapters. */
  .who-section {
    background: var(--green-soft);
    border-top: 8px solid var(--gold);
  }
  .who-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  /* The district's own premise, on a midnight slab closing the program section: the reader meets
     the program first, then the reason a school should care. Gold rule because this is the one
     thing on the page worth noticing. */
  .plan-slab {
    position: relative;
    z-index: 2;
    margin-top: clamp(2rem, 5vw, 3.25rem);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    background: var(--blue-deep);
    color: #fff;
    border-top: 3px solid var(--gold);
    border-radius: 6px 18px 12px 8px;
    box-shadow: var(--shadow-paper);
  }
  /* Keeps the global h2 `headline` step, as the callout heading had before. The quote sits a step
     below at `subtitle`, which is what DESIGN.md names for emphasis inside a coloured sheet. */
  .plan-slab__head {
    width: fit-content;
    margin: 0 0 0.6rem;
    padding: 0.1em 0.3em;
    /* Gold as a marker field with midnight ink, the same pairing as the highlight button — not
       gold type. */
    background: var(--gold);
    color: var(--blue-deep);
  }
  .plan-slab__source {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.02em;
    /* Not gold: gold is a marker here, never type (PRODUCT.md, DESIGN.md gold rule). The slab's
       gold is the top rule. */
    color: var(--blue-soft);
  }
  .plan-slab__source a {
    color: inherit;
  }
  /* The district's own words still outsize the prose framing them, one step below the heading. */
  .plan-slab__quote {
    margin: 0;
    font-size: 1.45rem;
    font-style: italic;
    font-weight: 800;
    line-height: 1.3;
    color: inherit;
  }
  .plan-slab__answer {
    margin: 1rem 0 0;
    /* +20% on the body step, at the user's request — a new size, not a documented ramp step. */
    font-size: 1.32rem;
    line-height: 1.65;
    color: var(--blue-soft);
  }
  /* Alignment reads like the policy spread: heading in the margin, prose in its own column,
     so a principal can scan for the goal they care about instead of reading a wall. */
  .align-rows {
    margin-top: clamp(1.5rem, 4vw, 2.75rem);
  }
  .align-row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 62ch);
    gap: clamp(1.25rem, 4vw, 3rem);
    padding: 1.9rem 0;
    border-top: 1px solid var(--rule);
  }
  .align-row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .align-row h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--blue);
  }
  .align-row p:last-child {
    margin-bottom: 0;
  }
  .ask-slip__note {
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.95rem;
    color: var(--muted);
  }
  /* The asks are the whole pitch to a school or civic partner, so they sit on their own
     slip with an index tab straddling the cut edge and a ticked row per ask. */
  .ask-slip {
    position: relative;
    margin-top: 1.6rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--page);
    border: 1px solid var(--rule);
    border-radius: 6px 20px 10px 8px;
    box-shadow: var(--shadow-paper);
  }
  .ask-slip__tab {
    position: absolute;
    top: -1.05rem;
    left: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0;
  }
  .ask-slip h3 {
    margin: 0.9rem 0 0;
    font-size: 1.15rem;
    color: var(--blue);
  }
  .ask-checklist {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .ask-checklist li {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding: 0.85rem 0;
    border-top: 1px solid var(--rule);
  }
  .ask-checklist li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .ask-checklist li:last-child {
    padding-bottom: 0;
  }
  .ask-checklist strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--blue-deep);
  }
  .ask-checklist p {
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .ask-tick {
    position: relative;
    width: 1.4rem;
    height: 1.6rem;
  }
  /* Pen tick drawn from two borders, matching the calendar and policy sheets. */
  .ask-tick::before {
    content: '';
    position: absolute;
    box-sizing: border-box;
    left: 0.1rem;
    top: 0.45rem;
    width: 0.9rem;
    height: 0.45rem;
    border-left: 3px solid var(--green-deep);
    border-bottom: 3px solid var(--green-deep);
    transform: rotate(-45deg);
  }
  .safety-section {
    background: var(--blue-deep);
    color: white;
  }
  .close-grid {
    padding: clamp(2rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
  }
  /* A parent landing on a page written for schools needs a door of their own, so the
     handoff is signposted as its own gold band rather than a hairline-ruled afterthought
     tacked onto the end of the partner CTA. */
  .join-signpost {
    padding: clamp(2rem, 4vw, 3rem) 0;
    background: var(--gold);
    color: var(--blue-deep);
  }
  .join-signpost__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .join-signpost__inner p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 900;
    max-width: 34ch;
  }
  /* This is the only route out of a page written for someone else, so its control is set
     a step above the site's default button rather than at body-CTA scale. */
  .join-signpost__inner .button {
    min-height: 62px;
    padding: 1rem 1.9rem;
    font-size: 1.1rem;
  }
  @media (max-width: 860px) {
    .align-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }
  @media (max-width: 800px) {
    .aims-grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 2rem;
    }
    .who-grid,
    .close-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .rank-list,
    .aims-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
