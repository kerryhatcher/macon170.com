---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterHero from '../../components/ChapterHero.astro';
import { pack, ranks } from '../../data/pack';
import { adventures } from '../../data/adventures';
import { denSlug } from '../../lib/den-slug';
import { officialImage } from '../../lib/official-image';
import { externalLink } from '../../lib/external-link';
import { breadcrumbSchema } from '../../lib/event-schema';

export function getStaticPaths() {
  return ranks.map((rank, index) => ({
    params: { den: denSlug(rank.name) },
    props: { rank, previous: ranks[index - 1] ?? null, next: ranks[index + 1] ?? null },
  }));
}

const { rank, previous, next } = Astro.props;
const program = adventures.find((entry) => entry.rank === rank.name);
---

<BaseLayout
  title={`${rank.name} den`}
  description={`What the ${rank.name} den (${rank.grade}) works on in Cub Scout Pack 170: required adventures, electives, and how the year runs.`}
  jsonLd={breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Dens', path: '/dens/' },
    { name: `${rank.name} den`, path: `/dens/${denSlug(rank.name)}/` },
  ])}
>
  <ChapterHero
    chapter={`${rank.name} den`}
    title={rank.name}
    accent={rank.grade}
    intro={program?.focus ?? `The ${rank.name} den is Pack 170’s den for ${rank.grade}.`}
    noteTitle="Badge of rank"
    noteBody={`Six required adventures plus two electives earn the ${rank.name} badge.`}
  >
    <p slot="note">Everything is done with the den or with family. There is nothing to study alone.</p>
  </ChapterHero>

  {
    program?.verified ? (
      <section class="section">
        <div class="container">
          <div class="section-heading">
            <span class="chapter-tab">Required adventures</span>
            <h2>The six every {rank.name} works on.</h2>
            <p>
              One adventure for each part of the program: character and leadership, the outdoors, personal fitness, citizenship, safety, and
              family and reverence. The den works through them together across the school year.
            </p>
          </div>
          <ol class="adventure-list">
            {program.required.map((adventure) => (
              <li>
                <Image
                  class="adventure-list__loop"
                  src={officialImage(adventure.icon)}
                  alt={`${adventure.name} adventure loop`}
                  width={54}
                  height={72}
                  densities={[1, 2]}
                  loading="lazy"
                />
                <div>
                  <strong>
                    <a href={adventure.url} {...externalLink(adventure.url)}>
                      {adventure.name}
                    </a>
                  </strong>
                  <p>{adventure.summary}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="grade-note">
            Bobcat comes first every year. It covers the Scout Oath, the Scout Law, the Cub Scout sign and handshake, and how to be a good
            den member, at a level written for {rank.grade}.
          </p>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container">
          <div class="notice">
            <span class="notice__pin">!</span>
            <div>
              <h3>Adventure list not confirmed yet</h3>
              <p>
                Pack 170 will not publish an adventure list it has not checked against Scouting America's current program. Until then, ask a
                den leader through the <a href="/contact/">contact form</a>, or look up the {rank.name} adventures on
                <a href="https://www.scouting.org/programs/cub-scouts/" target="_blank" rel="noopener">
                  scouting.org
                </a>
                .
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    program && program.electives.length > 0 && (
      <section class="section elective-section">
        <div class="container elective-grid">
          <div>
            <span class="chapter-tab">Electives</span>
            <h2>Then two the den picks.</h2>
            <p class="lead">
              {`${rank.name} Scouts choose their last two adventures from the ${program.electives.length} electives below.`} Dens usually
              pick together, based on what the Scouts are curious about and what the season allows.
            </p>
          </div>
          <div class="notice">
            <span class="notice__pin">?</span>
            <div>
              <h3>This den’s schedule</h3>
              <p>
                The {rank.name} den sets its own meeting day and time after the first pack meeting of the school year, so it is not listed
                here yet. Pack-wide dates are on the <a href="/calendar/">Calendar</a>, and a den leader can tell you the rest.
              </p>
              <p>
                <a href="/contact/">Ask about the {rank.name} den →</a>
              </p>
            </div>
          </div>
        </div>
        <div class="container">
          <ul class="adventure-list adventure-list--electives">
            {program.electives.map((adventure) => (
              <li>
                <Image
                  class="adventure-list__loop"
                  src={officialImage(adventure.icon)}
                  alt={`${adventure.name} adventure loop`}
                  width={54}
                  height={72}
                  densities={[1, 2]}
                  loading="lazy"
                />
                <div>
                  <strong>
                    <a href={adventure.url} {...externalLink(adventure.url)}>
                      {adventure.name}
                    </a>
                  </strong>
                  <p>{adventure.summary}</p>
                </div>
              </li>
            ))}
          </ul>
          {program.specialElectives.length > 0 && (
            <div class="special-electives">
              <h3>Special elective adventures</h3>
              <p>
                Scouting America lists these on their own because they need a certified instructor and an approved range, so they happen at
                council and district events such as day camp rather than at a den meeting, and there is no adventure page for them. Ask a
                den leader whether one of these counts toward a Scout’s two electives.
              </p>
              <ul>
                {program.specialElectives.map((adventure) => (
                  <li>
                    <strong>{adventure.name}.</strong> {adventure.summary}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container den-footer">
      <div class="paper-sheet den-footer__sheet">
        <h2>Where the {rank.name} den meets</h2>
        <p>
          Pack meetings bring all six dens together {pack.meeting.cadence.toLowerCase()} on a {pack.meeting.day} at {pack.meeting.time}, at
          {' '}{pack.meeting.location}, {pack.meeting.address}. Den meetings are scheduled by that den’s leader.
        </p>
        <p><a class="button button--blue" href="/join/">Join the {rank.name} den</a></p>
      </div>
      <nav class="den-nav" aria-label="Other dens">
        <h2>Other dens</h2>
        <ul>
          {
            previous && (
              <li>
                <a href={`/dens/${denSlug(previous.name)}/`}>
                  ← {previous.name} ({previous.grade})
                </a>
              </li>
            )
          }
          {
            next && (
              <li>
                <a href={`/dens/${denSlug(next.name)}/`}>
                  {next.name} ({next.grade}) →
                </a>
              </li>
            )
          }
          <li><a href="/dens/">All six dens</a></li>
        </ul>
      </nav>
    </div>
  </section>

  {
    program?.verified && (
      <p class="container source-note">
        Adventure names, links, and loop images taken from{' '}
        <a href={program.source} {...externalLink(program.source)}>
          {new URL(program.source).hostname}
        </a>
        , July 2026. The one-line descriptions are Pack 170’s own summaries of each linked page, not Scouting America’s wording. Follow a
        link for the actual requirements. Scouting America updated the Cub Scout adventure program on June 1, 2024.
      </p>
    )
  }
</BaseLayout>
<style>
  .adventure-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .adventure-list li {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--page);
    box-shadow: 3px 5px 0 var(--rule);
  }
  /* A sewn-in bookmark tab at the corner, not a rail down the whole edge.
     Absolutely positioned so it stays out of the flex flow. */
  .adventure-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 5px;
    height: 1.75rem;
    background: var(--blue);
  }
  .adventure-list__loop {
    flex: 0 0 auto;
    width: 54px;
    height: auto;
  }
  .adventure-list strong {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.2;
  }
  .adventure-list p {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
    line-height: 1.45;
    /* the elective list sits on the green section, so pin the card text to the body colour */
    color: var(--ink);
  }
  .adventure-list--electives {
    margin-top: 2.5rem;
    border-top: 2px solid rgba(255, 255, 255, 0.35);
    padding-top: 2.5rem;
  }
  .adventure-list--electives li {
    border-left-color: var(--green-deep);
  }
  .special-electives {
    margin-top: 2.5rem;
    max-width: var(--reading);
  }
  .special-electives ul {
    margin: 1rem 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
  }
  .elective-section {
    background: var(--green-deep);
    color: white;
  }
  .elective-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4rem;
    align-items: start;
  }
  .den-footer {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 3rem;
    align-items: start;
  }
  .den-footer__sheet {
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .den-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .source-note {
    padding-bottom: 3rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: var(--reading);
  }
  @media (max-width: 900px) {
    .adventure-list {
      grid-template-columns: repeat(2, 1fr);
    }
    .elective-grid,
    .den-footer {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  @media (max-width: 560px) {
    .adventure-list {
      grid-template-columns: 1fr;
    }
  }
</style>
