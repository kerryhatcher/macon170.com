---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterHero from '../components/ChapterHero.astro';
import { pack } from '../data/pack';
import { externalLink } from '../lib/external-link';
const hasEndpoint = Boolean(pack.contact.formEndpoint);
const turnstileSiteKey = '0x4AAAAAAD-sr-Bk7AntxyZ7';
---

<BaseLayout title="Contact Pack 170" description="Parents and guardians can contact adult volunteers with Cub Scout Pack 170 questions.">
  <ChapterHero
    chapter="Grown-up help"
    title="Ask a Pack 170"
    accent="adult"
    intro="Questions about a first visit, a schedule, or where your family fits? This contact path is for parents and guardians and routes to multiple adult volunteers."
    noteTitle="Youth safety first"
    noteBody="No one-to-one adult–youth contact"
    ><p slot="note">
      A parent or guardian should send every inquiry. Please do not include sensitive information about a child.
    </p></ChapterHero
  >
  <section class="section">
    <div class="container contact-grid">
      <form
        class="paper-sheet contact-form"
        id="contact-form"
        method="post"
        action={pack.contact.formEndpoint ?? undefined}
        aria-describedby={!hasEndpoint ? 'form-status' : undefined}
      >
        <span class="chapter-tab">Parent note</span><h2>Send a question</h2><div
          class="success-message"
          id="submission-success"
          role="status"
          tabindex="-1"
          hidden
        >
          <strong>Your note is in the volunteer desk.</strong><span
            >A Pack 170 adult can review it securely and reply using the parent contact details you provided.</span
          >
        </div><div class="field-row">
          <label for="parent-name">Parent or guardian name</label><input
            id="parent-name"
            name="parentName"
            autocomplete="name"
            maxlength="120"
            required
          />
        </div><div class="field-row">
          <label for="email">Your email</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
        </div><div class="field-row">
          <label for="phone">Parent phone <span>(optional)</span></label><input
            id="phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            maxlength="40"
          />
        </div><div class="field-row">
          <label for="child-grade">Child’s grade <span>(optional—no child name)</span></label><select id="child-grade" name="childGrade"
            ><option value="">Choose a grade</option><option>Kindergarten</option><option>1st grade</option><option>2nd grade</option
            ><option>3rd grade</option><option>4th grade</option><option>5th grade</option></select
          >
        </div><div class="field-row">
          <label for="topic">What can we help with?</label><select id="topic" name="topic"
            ><option>Planning a first visit</option><option>Calendar or event detail</option><option>Finding my child’s den</option><option
              >Volunteering</option
            ><option>Website or privacy question</option><option>Something else</option></select
          >
        </div><div class="field-row">
          <label for="message">Your question</label><textarea id="message" name="message" rows="6" minlength="10" maxlength="4000" required
          ></textarea><small
            >Please do not send a child’s full name, school, address, medical information, or other sensitive details.</small
          >
        </div><div class="website-field" aria-hidden="true">
          <label for="website">Leave this blank</label><input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div><div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-action="turnstile-spin-v2"
          data-size="flexible"
          data-theme="light"
        >
        </div><button class="button button--blue" type="submit" disabled={!hasEndpoint}
          >{hasEndpoint ? 'Send securely to pack adults' : 'Form connection pending'}</button
        >{
          !hasEndpoint && (
            <p class="form-status" id="form-status" role="status">
              The secure form connection is not ready yet.
            </p>
          )
        }
      </form><aside>
        <div class="notice">
          <span class="notice__pin">✓</span><div>
            <h3>Stored securely for volunteers</h3><p>
              Your note is saved in Pack 170’s Cloudflare database. Only allowlisted volunteers who sign in through Cloudflare Access can
              open the volunteer desk.
            </p>
          </div>
        </div><div class="contact-card">
          <h2>Need council help instead?</h2><p>
            Central Georgia Council<br />{pack.council.phone}<br /><a href={`mailto:${pack.council.email}`}>{pack.council.email}</a>
          </p><p><a href={pack.council.url} {...externalLink(pack.council.url)}>Council website</a></p>
        </div><div class="contact-card">
          <h2>Visit location</h2><p>{pack.meeting.location}<br />{pack.meeting.address}</p><p>
            Pack meetings are roughly monthly. Confirm the date before making a special trip.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
<style>
  .contact-grid {
    display: grid;
    /* minmax(0, …) rather than a bare fr: an fr track floors at its content's min-content
       width, and the form controls inside pushed that floor to 350px, so at 320px both
       columns overflowed the 300px container instead of shrinking. */
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .contact-form {
    padding: clamp(1.5rem, 5vw, 3.5rem);
  }
  .field-row {
    display: grid;
    gap: 0.4rem;
    margin: 1.2rem 0;
  }
  .field-row label {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--blue-deep);
  }
  input,
  select,
  textarea {
    width: 100%;
    /* Form controls carry an intrinsic minimum width from their default character size;
       without this they refuse to shrink below it on a 320px screen. */
    min-width: 0;
    border: 2px solid var(--field-stroke);
    border-radius: 7px 12px 6px 7px;
    background: white;
    color: var(--ink);
    padding: 0.75rem;
  }
  textarea {
    resize: vertical;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--blue);
    outline: 3px solid var(--blue-deep);
    outline-offset: 0;
    box-shadow: var(--ring-focus);
  }
  .field-row small {
    color: var(--muted);
  }
  .form-status {
    font-size: 0.95rem;
    color: var(--red);
    margin-top: 1rem;
  }
  .contact-card {
    border-top: 4px solid var(--blue);
    padding: 1.5rem 0.25rem;
    margin-top: 2rem;
  }
  .contact-card h2 {
    font-size: 1.4rem;
  }
  code {
    font-size: 0.85em;
  }
  .field-row label span {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--muted);
  }
  .website-field {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .success-message {
    display: grid;
    gap: 0.25rem;
    margin: 1rem 0 1.5rem;
    padding: 1rem;
    background: var(--notice-green);
    border: 2px solid var(--green);
    border-radius: 6px 14px 7px 6px;
    color: var(--green-deep);
  }
  .cf-turnstile {
    margin: 1.25rem 0;
    min-height: 65px;
  }
  /* Turnstile draws a fixed 300px-wide widget, and no amount of shrinking the sheet fits
     300px inside a 320px screen once the container gutter, sheet padding, and border are
     paid for. Scaling from the left edge keeps the whole challenge visible and on the
     sheet; clipping or shrinking the padding instead would hide part of a control the
     parent has to interact with to send the form. */
  @media (max-width: 400px) {
    .cf-turnstile {
      width: 300px;
      transform: scale(0.82);
      transform-origin: left top;
      min-height: 0;
      height: 54px;
    }
  }
  @media (max-width: 760px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const success = document.querySelector<HTMLElement>('#submission-success');
  const params = new URLSearchParams(window.location.search);
  if (success && params.get('submitted') === 'success') {
    success.hidden = false;
    success.focus();
    window.history.replaceState({}, '', `${window.location.pathname}#contact-form`);
  }
</script>
