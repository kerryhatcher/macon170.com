---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignupTurnstile from '../../components/SignupTurnstile.astro';
---

<BaseLayout title="Pack 170 signup" description="Sign up or claim an item for an upcoming Cub Scout Pack 170 event.">
  <section class="signup-hero">
    <div class="container">
      <span class="chapter-tab">Pack 170 signup</span><h1 id="signup-title">Loading signup…</h1><p class="lead" id="signup-summary">
        Retrieving the volunteer-published signup.
      </p>
    </div>
  </section>
  <section class="signup-detail-section">
    <div class="container">
      <article class="signup-sheet" id="signup-detail">
        <div class="loading" role="status" id="signup-loading">Loading signup…</div>
        <noscript
          ><style>
            .loading {
              display: none;
            }
          </style><h2>JavaScript is needed for signups</h2><p>
            Signups load and submit from your browser. Please contact Pack 170 adults to sign up without JavaScript.
          </p><a href="/contact/">Ask the pack</a></noscript
        >
        <div class="notice notice--editor" id="signup-closed" role="status" hidden>
          <span class="notice__pin" aria-hidden="true">!</span><div>
            <h3>This signup is closed</h3><p>
              Pack 170 is no longer accepting responses for this signup. Contact the pack if you still need to reach the organizers.
            </p>
          </div>
        </div>
        <div class="notice notice--success" id="signup-success" role="status" tabindex="-1" hidden>
          <span class="notice__pin" aria-hidden="true">✓</span><div>
            <h3>Check your email</h3><p>
              We sent a link to your email. It confirms this signup and is also how you come back later to change or cancel it.
            </p>
          </div>
        </div>
        <div class="notice notice--editor" id="signup-error" role="alert" tabindex="-1" hidden>
          <span class="notice__pin" aria-hidden="true">!</span><div>
            <h3 id="signup-error-title"></h3>
            <p id="signup-error-message"></p>
          </div>
        </div>
        <p class="signup-instructions" id="signup-instructions" hidden></p>
        <form id="signup-form" hidden>
          <div class="field-row">
            <label for="family-name">Your Name</label><input
              id="family-name"
              name="familyName"
              required
              minlength="2"
              maxlength="120"
              autocomplete="name"
            />
          </div>
          <div class="field-row">
            <label for="phone">Phone number</label><input id="phone" name="phone" type="tel" required maxlength="40" autocomplete="tel" />
          </div>
          <div class="field-row">
            <label for="email">Your email</label><input
              id="email"
              name="email"
              type="email"
              required
              maxlength="254"
              autocomplete="email"
            />
          </div>
          <fieldset id="rsvp-fields" class="field-row" hidden>
            <label class="checkbox-row"><input id="attending" type="checkbox" checked /> We plan to attend</label>
            <div class="rsvp-counts">
              <label for="adults">Adults</label><input id="adults" type="number" inputmode="numeric" min="0" max="20" value="0" /><label
                for="children">Children</label
              ><input id="children" type="number" inputmode="numeric" min="0" max="20" value="0" />
            </div>
          </fieldset>
          <div class="field-row" id="claim-fields" hidden>
            <p id="claim-hint" class="claim-hint" hidden>Pick at least one item before sending.</p>
            <ul id="claim-rows"></ul>
          </div>
          <div class="field-row">
            <label for="dietary-notes">Allergies or dietary needs (optional)</label><textarea id="dietary-notes" maxlength="500"
            ></textarea><small>Shared only with the volunteers organizing this event. It is never shown on this page.</small>
          </div>
          <div class="website-field" aria-hidden="true">
            <label for="website">Leave this blank</label><input id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <SignupTurnstile />
          <button class="button button--blue" type="submit" id="signup-submit" disabled>Send signup</button>
        </form>
      </article>
    </div>
  </section>
</BaseLayout>
<script>
  import { getSignupForm, submitSignupResponse, SignupClientError, type PublicSignupForm } from '../../lib/signup-client';
  import { buildClaimRows, setClaimQuantity, reconcileClaimRows, toClaimPayload, type ClaimRow } from '../../lib/signup-claims';
  import { createTurnstileController, type TurnstileView } from '../../lib/contact-turnstile';

  type QueuedTurnstileEvent = ['success' | 'error' | 'expired', string?];
  type TurnstileEventHandler = (event: QueuedTurnstileEvent[0], detail?: string) => boolean | void;
  declare global {
    interface Window {
      __pack170TurnstileEvents?: QueuedTurnstileEvent[];
      __pack170TurnstileHandler?: TurnstileEventHandler;
    }
  }

  const esc = (value: string) =>
    value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[c] ?? c);
  const part = (value: string, options: Intl.DateTimeFormatOptions) =>
    new Intl.DateTimeFormat(undefined, { timeZone: 'America/New_York', ...options }).format(new Date(value));

  const errors: Record<string, { title: string; message: string }> = {
    slot_full: {
      title: 'Someone claimed the last one first.',
      message: 'The counts below are up to date. Adjust what you can bring and send again.',
    },
    rate_limit: { title: 'Please wait a minute.', message: 'Several signups were sent recently. Wait a moment, then try again.' },
    security: {
      title: 'The security check did not finish.',
      message: 'Refresh the page, complete the security check again, and send your signup.',
    },
    email_failed: {
      title: 'Your signup saved, but the email did not send.',
      message: 'Send the form again in a few minutes and we will re-send your link. You will not be signed up twice.',
    },
    validation: { title: 'Check the form and try again.', message: 'One or more answers were missing or invalid.' },
    temporary: {
      title: 'The signup service is temporarily unavailable.',
      message: 'Your signup was not saved. Try again in a few minutes.',
    },
  };

  const slug = new URLSearchParams(location.search).get('form');
  const detail = document.querySelector<HTMLElement>('#signup-detail');
  const loadingIndicator = document.querySelector<HTMLElement>('#signup-loading');
  const title = document.querySelector<HTMLElement>('#signup-title');
  const summary = document.querySelector<HTMLElement>('#signup-summary');
  const closedNotice = document.querySelector<HTMLElement>('#signup-closed');
  const form = document.querySelector<HTMLFormElement>('#signup-form');
  const success = document.querySelector<HTMLElement>('#signup-success');
  const errorNotice = document.querySelector<HTMLElement>('#signup-error');
  const errorTitle = document.querySelector<HTMLElement>('#signup-error-title');
  const errorMessage = document.querySelector<HTMLElement>('#signup-error-message');
  const rsvpFields = document.querySelector<HTMLElement>('#rsvp-fields');
  const claimFields = document.querySelector<HTMLElement>('#claim-fields');
  const claimRowsList = document.querySelector<HTMLUListElement>('#claim-rows');
  const claimHint = document.querySelector<HTMLElement>('#claim-hint');
  const submitButton = document.querySelector<HTMLButtonElement>('#signup-submit');
  const instructions = document.querySelector<HTMLElement>('#signup-instructions');

  const notFound = () => {
    if (detail)
      detail.innerHTML =
        '<h2>Signup not found</h2><p>This signup may be a draft or no longer available. Return to the <a href="/calendar/">Pack calendar</a>.</p>';
  };
  const trouble = () => {
    if (detail)
      detail.innerHTML =
        '<h2>We could not load this signup</h2><p>The connection to the Pack 170 CMS failed. Please try again in a moment, or contact Pack 170 adults.</p><a class="button button--blue" href="/contact/">Ask the pack</a>';
  };

  let currentForm: PublicSignupForm | null = null;
  let rows: ClaimRow[] = [];
  let turnstileToken: string | null = null;

  function renderClaimRows() {
    if (!claimRowsList) return;
    claimRowsList.innerHTML = rows
      .map(
        (row) =>
          `<li data-slot="${esc(row.slotId)}">` +
          `<div class="claim-row__head"><span class="claim-row__label">${esc(row.label)}</span>` +
          (row.notes ? `<span class="claim-row__notes">${esc(row.notes)}</span>` : '') +
          `</div>` +
          `<p class="claim-row__summary">${esc(row.summary)}</p>` +
          `<input type="number" inputmode="numeric" min="0" max="${row.max}" value="${row.quantity}" aria-label="Quantity of ${esc(
            row.label,
          )} to bring"${row.max === 0 ? ' disabled' : ''} />` +
          `</li>`,
      )
      .join('');
  }

  claimRowsList?.addEventListener('input', (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement)) return;
    const li = input.closest<HTMLElement>('li[data-slot]');
    const slotId = li?.getAttribute('data-slot');
    if (!slotId) return;
    rows = setClaimQuantity(rows, slotId, Number(input.value));
    const updated = rows.find((row) => row.slotId === slotId);
    if (updated) input.value = String(updated.quantity);
    claimHint?.setAttribute('hidden', '');
  });

  function showError(info: { title: string; message: string }) {
    if (errorTitle) errorTitle.textContent = info.title;
    if (errorMessage) errorMessage.textContent = info.message;
    errorNotice?.removeAttribute('hidden');
    errorNotice?.focus();
  }

  async function load() {
    if (!slug || !/^[a-z0-9-]{2,80}$/.test(slug)) {
      notFound();
      return;
    }
    try {
      currentForm = await getSignupForm(slug);
    } catch (error) {
      if (error instanceof SignupClientError && error.status === 404) {
        notFound();
        return;
      }
      throw error;
    }
    const f = currentForm;
    document.title = f.title + ' | Cub Scout Pack 170';
    if (title) title.textContent = f.title;
    if (summary) summary.textContent = `Help the pack with “${f.event.title}” on ${part(f.event.startsAt, { dateStyle: 'long' })}.`;
    loadingIndicator?.setAttribute('hidden', '');
    if (f.instructions && instructions) {
      instructions.textContent = f.instructions;
      instructions.removeAttribute('hidden');
    }

    if (f.closed) {
      closedNotice?.removeAttribute('hidden');
      return;
    }

    form?.removeAttribute('hidden');
    if (f.formType === 'rsvp') rsvpFields?.removeAttribute('hidden');
    if (f.formType === 'items') {
      claimFields?.removeAttribute('hidden');
      rows = buildClaimRows(f);
      renderClaimRows();
    }

    const renderTurnstile = ({ submitEnabled, statusMessage, showUnavailableNotice }: TurnstileView) => {
      if (submitButton) submitButton.disabled = !submitEnabled;
      const turnstileStatus = document.querySelector<HTMLElement>('#turnstile-status');
      const turnstileNotice = document.querySelector<HTMLElement>('#turnstile-notice');
      turnstileStatus?.toggleAttribute('hidden', statusMessage === null);
      if (turnstileStatus) turnstileStatus.textContent = statusMessage ?? '';
      turnstileNotice?.toggleAttribute('hidden', !showUnavailableNotice);
      if (showUnavailableNotice) {
        submitButton?.setAttribute('aria-describedby', 'turnstile-notice');
      } else if (statusMessage) {
        submitButton?.setAttribute('aria-describedby', 'turnstile-status');
      } else {
        submitButton?.removeAttribute('aria-describedby');
      }
    };
    const turnstileController = createTurnstileController(renderTurnstile);
    window.__pack170TurnstileHandler = (event, tokenOrCode) => {
      if (event === 'success') {
        turnstileToken = tokenOrCode ?? null;
        turnstileController.success();
      } else if (event === 'expired') {
        turnstileToken = null;
        turnstileController.expired();
      } else {
        return turnstileController.error();
      }
    };
    const earlyEvents = window.__pack170TurnstileEvents ?? [];
    window.__pack170TurnstileEvents = [];
    earlyEvents.forEach(([event, tokenOrCode]) => window.__pack170TurnstileHandler?.(event, tokenOrCode));
    window.addEventListener(
      'pagehide',
      () => {
        window.__pack170TurnstileHandler = undefined;
        turnstileController.destroy();
      },
      { once: true },
    );

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!currentForm || !submitButton) return;
      const claims = toClaimPayload(rows);
      if (currentForm.formType === 'items' && claims.length === 0) {
        claimHint?.removeAttribute('hidden');
        return;
      }
      submitButton.disabled = true;
      errorNotice?.setAttribute('hidden', '');

      const familyName = (document.querySelector<HTMLInputElement>('#family-name')?.value ?? '').trim();
      const email = (document.querySelector<HTMLInputElement>('#email')?.value ?? '').trim();
      const phone = (document.querySelector<HTMLInputElement>('#phone')?.value ?? '').trim();
      const attending = document.querySelector<HTMLInputElement>('#attending')?.checked ?? true;
      const adults = Number(document.querySelector<HTMLInputElement>('#adults')?.value ?? 0);
      const children = Number(document.querySelector<HTMLInputElement>('#children')?.value ?? 0);
      const dietaryNotes = (document.querySelector<HTMLTextAreaElement>('#dietary-notes')?.value ?? '').trim();
      const website = document.querySelector<HTMLInputElement>('#website')?.value ?? '';

      try {
        await submitSignupResponse(slug, {
          email,
          familyName,
          phone,
          attending,
          adults,
          children,
          dietaryNotes: dietaryNotes || null,
          claims,
          website,
          'cf-turnstile-response': turnstileToken ?? '',
        });
        form?.setAttribute('hidden', '');
        success?.removeAttribute('hidden');
        success?.focus();
      } catch (error) {
        if (error instanceof SignupClientError && error.status === 409 && error.form) {
          rows = reconcileClaimRows(rows, error.form);
          renderClaimRows();
          showError(errors.slot_full);
          submitButton.disabled = false;
          return;
        }
        const code = error instanceof SignupClientError ? error.code : undefined;
        const status = error instanceof SignupClientError ? error.status : undefined;
        const key = code && errors[code] ? code : status === 502 ? 'email_failed' : 'temporary';
        showError(errors[key]);
        submitButton.disabled = false;
      }
    });
  }

  load().catch(() => {
    if (title) title.textContent = 'Signup unavailable';
    if (summary) summary.textContent = 'We could not reach the Pack 170 CMS.';
    trouble();
  });
</script>
<style>
  .signup-hero {
    padding: clamp(4rem, 9vw, 7rem) 0;
    background: var(--blue);
    color: white;
    border-bottom: 8px solid var(--gold);
  }
  .signup-hero h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
  }
  .signup-hero .lead {
    color: var(--blue-soft);
  }
  .signup-detail-section {
    padding: clamp(3rem, 7vw, 5.5rem) 0;
  }
  .signup-sheet {
    background: var(--page);
    color: var(--ink);
    border-radius: 6px 22px 12px 8px;
    box-shadow: var(--shadow-paper);
    padding: clamp(1.75rem, 4vw, 3.25rem);
    max-width: 640px;
    margin: 0 auto;
  }
  .loading {
    color: var(--muted);
  }
  .signup-instructions {
    margin: 0 0 1.5rem;
    white-space: pre-line;
  }
  .field-row {
    display: grid;
    gap: 0.4rem;
    margin: 1.2rem 0;
  }
  .field-row label {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--blue-deep);
  }
  input,
  textarea {
    width: 100%;
    min-width: 0;
    border: 2px solid var(--field-stroke);
    border-radius: 7px 12px 6px 7px;
    background: white;
    color: var(--ink);
    padding: 0.75rem;
  }
  textarea {
    resize: vertical;
  }
  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--blue);
    outline: 3px solid var(--blue-deep);
    outline-offset: 0;
    box-shadow: var(--ring-focus);
  }
  .field-row small {
    color: var(--muted);
  }
  .website-field {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  fieldset {
    border: none;
    padding: 0;
  }
  .checkbox-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--blue-deep);
  }
  .checkbox-row input {
    width: auto;
  }
  .rsvp-counts {
    display: grid;
    grid-template-columns: auto 5.5rem auto 5.5rem;
    gap: 0.6rem;
    align-items: center;
    margin-top: 0.75rem;
  }
  #claim-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  #claim-rows li {
    border: 1px solid var(--rule);
    border-radius: 6px 14px 7px 6px;
    padding: 0.9rem;
    display: grid;
    gap: 0.5rem;
  }
  .claim-row__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .claim-row__label {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--blue-deep);
  }
  .claim-row__notes {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .claim-row__summary {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }
  #claim-rows input {
    width: 6rem;
  }
  .claim-hint {
    color: var(--red);
    font-size: 0.95rem;
  }
  @media (max-width: 400px) {
    .rsvp-counts {
      grid-template-columns: 1fr;
    }
  }
</style>
