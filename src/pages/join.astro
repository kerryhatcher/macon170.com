---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterHero from '../components/ChapterHero.astro';
import RankEmblem from '../components/RankEmblem.astro';
import { pack, ranks } from '../data/pack';
const faq = [
  [
    'Does my family need to belong to the church?',
    'No. Pack 170 welcomes families from every background. Highland Hills Baptist Church is our chartered organization and meeting home.',
  ],
  [
    'Can girls join Pack 170?',
    'Yes. Cub Scouting welcomes boys and girls in kindergarten through 5th grade, and Pack 170 runs a den for every grade.',
  ],
  [
    'Do we need a uniform for the first visit?',
    'No. Come as you are for a first visit. Pack adults can explain current uniform and handbook expectations before you buy anything.',
  ],
  [
    'How often do Cub Scouts meet?',
    'The full pack gathers roughly once a month on Tuesdays at 6:30 PM. Each den sets its own schedule; many meet for an hour before the pack meeting.',
  ],
];
---

<BaseLayout
  title="Join Pack 170"
  description="Plan a first visit to Cub Scout Pack 170 in Macon. Learn who can join, when we meet, what to expect, and how to begin."
>
  <ChapterHero
    chapter="First-visit chapter"
    title="Your family’s first"
    accent="Pack 170 visit"
    intro="No uniform. No experience. No pressure. Come meet the adults who run the pack, see what Cub Scouts are working on, and decide together whether it feels right."
    noteTitle="You’re invited to the next meeting!"
    noteBody="Loading the next scheduled Pack 170 meeting…"
  >
    <div slot="actions" class="hero-actions">
      <a class="button button--gold" href={pack.links.join}>Start with BeAScout</a><a class="button button--paper" href="/contact/"
        >Ask a pack adult</a
      >
    </div>
    <p slot="note">
      <strong>{pack.meeting.location}</strong><br />{pack.meeting.address}
    </p>
  </ChapterHero>

  <section class="section">
    <div class="container visit-grid">
      <div class="paper-sheet checklist">
        <span class="chapter-tab">Before you come</span><h2>A very short packing list</h2>
        <ol>
          <li>
            <strong>Bring your child.</strong><span>Cub Scouting is designed for kids and their families to experience together.</span>
          </li><li><strong>Wear everyday clothes.</strong><span>A first visit does not require a uniform or special gear.</span></li><li>
            <strong>Bring your questions.</strong><span
              >Ask about dens, schedules, cost, volunteering, or anything else your family needs.</span
            >
          </li>
        </ol>
      </div>
      <div>
        <span class="chapter-tab">What happens</span><h2>Look around before you leap.</h2>
        <p class="lead">
          A first visit is an introduction, not a commitment. You can expect a busy room, families arriving together, and age-appropriate
          activities led by adult volunteers.
        </p>
        <div class="notice">
          <span class="notice__pin">✓</span><div>
            <h3>Parent-to-parent clarity</h3><p>
              All contact and registration steps are addressed to a parent or guardian. Pack 170 does not create one-to-one adult–youth
              communication channels.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section grade-guide" id="grades">
    <div class="container">
      <div class="section-heading">
        <span class="chapter-tab">Which den?</span><h2>Start with your child’s grade.</h2><p>
          Cub Scout rank names follow elementary grades, and Pack 170 runs all six dens. Each den sets its own meeting time and place after
          the first pack meeting of the school year, so ask a pack adult where your child’s den has landed.
        </p><p>
          New to Cub Scouting? <a href="/what-is-cub-scouts/">Start with what the program is</a>, or open a den to see
          <a href="/dens/">what that grade works on</a>.
        </p>
      </div>
      <div class="rank-path">
        {
          ranks.map((rank) => (
            <div class:list={['rank', `rank--${rank.color}`]}>
              <>
                <RankEmblem emblem={rank.emblem} name={rank.name} />
                <strong>{rank.name}</strong>
                <small>{rank.grade}</small>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cost-grid">
      <div>
        <span class="chapter-tab">Cost & gear</span><h2>Know the real number before you register.</h2><p class="lead">
          The only cost to join is Scouting America’s national registration fee: <strong>{pack.cost.youth}</strong> and
          <strong>{pack.cost.adult}</strong>. {pack.cost.localDues}
          {pack.cost.optional} Uniform pieces and handbooks are a separate cost — ask pack adults what your family actually needs before buying
          anything.
        </p>
        <p>
          <strong>Military families:</strong> Scouting America waives {pack.cost.militaryWaiver.covers} for {
            pack.cost.militaryWaiver.eligibility
          }.
          {pack.cost.militaryWaiver.how}
          <small>{pack.cost.militaryWaiver.caveat}</small>
        </p>
      </div>
      <div class="notice">
        <span class="notice__pin">?</span><div>
          <h3>Cost should never be the reason</h3><p>
            If the registration fee is a hardship for your family, talk to a pack leader. <a href="/contact/">Reach out</a> and we will work it
            out.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container faq-grid">
      <div><span class="chapter-tab">Family questions</span><h2>Things parents ask before the first Tuesday.</h2></div><div
        class="faq-list"
      >
        {
          faq.map(([q, a]) => (
            <details>
              <>
                <summary>{q}</summary>
                <p>{a}</p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section join-close">
    <div class="container paper-sheet join-close__sheet">
      <h2>Ready to turn the first page?</h2><p>Start on BeAScout, or contact Pack 170 adults if you want a local answer first.</p><div>
        <a class="button button--gold" href={pack.links.join}>Open BeAScout</a><a class="button button--paper" href="/contact/"
          >Contact the pack</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  import { API_BASE } from '../lib/api-base';
  type PublicEvent = {
    title: string;
    status: string;
    category: string;
    starts_at: string;
    ends_at: string | null;
  };
  const note = document.querySelector<HTMLElement>('.hero-note > p');
  const fallback = 'Roughly monthly · Tuesdays · 6:30 PM';
  const date = (value: string) =>
    new Intl.DateTimeFormat(undefined, { dateStyle: 'full', timeStyle: 'short', timeZone: 'America/New_York' }).format(new Date(value));
  const time = (value: string) =>
    new Intl.DateTimeFormat(undefined, { timeStyle: 'short', timeZone: 'America/New_York' }).format(new Date(value));

  async function loadNextPackMeeting() {
    if (!note) return;
    try {
      const response = await fetch(`${API_BASE}/api/events`);
      if (!response.ok) throw new Error();
      const body = (await response.json()) as { events?: PublicEvent[] };
      const meeting = body.events?.find(
        (event) => event.category === 'pack' && event.status === 'scheduled' && event.title.toLowerCase().includes('pack meeting'),
      );
      if (!meeting) {
        note.textContent = fallback;
        return;
      }
      const end = meeting.ends_at ? `–${time(meeting.ends_at)}` : '';
      note.textContent = `${date(meeting.starts_at)}${end}`;
    } catch {
      note.textContent = fallback;
    }
  }

  loadNextPackMeeting();
</script>
<style>
  .hero-actions,
  .join-close__sheet div {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .visit-grid,
  .cost-grid,
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .checklist {
    padding: clamp(1.5rem, 4vw, 3rem);
    transform: rotate(-0.5deg);
  }
  .checklist ol {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    counter-reset: steps;
  }
  .checklist li {
    counter-increment: steps;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 0.8rem;
    margin: 1.4rem 0;
  }
  .checklist li::before {
    content: counter(steps);
    grid-row: 1/3;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    background: var(--gold);
    color: var(--blue-deep);
    border: 3px solid var(--blue);
    border-radius: 50%;
    font-family: var(--font-display);
    font-weight: 900;
  }
  .checklist strong,
  .checklist span {
    grid-column: 2;
    line-height: 1.35;
  }
  .checklist span {
    color: var(--muted);
  }
  .grade-guide,
  .faq-section {
    background: var(--page);
    border-block: 1px solid var(--rule);
  }
  .faq-list details {
    border-bottom: 2px solid var(--rule);
    padding: 1.15rem 0;
  }
  .faq-list summary {
    cursor: pointer;
    color: var(--blue);
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.3;
  }
  .faq-list p {
    padding: 0.8rem 1rem 0;
    margin: 0;
  }
  .join-close {
    background: var(--blue-soft);
  }
  .join-close__sheet {
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }
  .join-close__sheet p {
    font-size: 1.2rem;
  }
  .join-close__sheet div {
    justify-content: center;
  }
  @media (max-width: 780px) {
    .visit-grid,
    .cost-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .hero-actions .button {
      flex: 1;
    }
    .checklist {
      transform: none;
    }
  }
</style>
