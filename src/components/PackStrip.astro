---
import { pack } from '../data/pack';
---

<aside class="pack-strip" aria-label="Pack essentials">
  <div class="pack-strip__inner">
    <div class="pack-strip__item">
      <span class="pack-strip__label">We gather</span>
      <strong class="pack-strip__value">Monthly {pack.meeting.day} · {pack.meeting.time} · {pack.meeting.location}</strong>
    </div>
    <div class="pack-strip__item">
      <span class="pack-strip__label">Next up</span>
      <a
        class="pack-strip__value pack-strip__next-link"
        id="pack-strip-next-event"
        href="/calendar/"
        aria-label="Open the Pack calendar"
        >The next date is being added</a
      >
    </div>
    <div class="pack-strip__actions">
      <a class="button button--paper" href="/join/">New here</a>
      <a class="button button--blue" href="/calendar/">Calendar</a>
    </div>
  </div>
</aside>
<script>
  type PublicEvent = { slug: string; title: string };
  const nextEventLink = document.querySelector<HTMLAnchorElement>('#pack-strip-next-event');
  const compactTitle = (title: string) => (title.length > 44 ? `${title.slice(0, 41).trimEnd()}…` : title);

  async function loadNextEvent() {
    if (!nextEventLink) return;
    try {
      const response = await fetch('/api/events');
      if (!response.ok) return;
      const body = (await response.json()) as { events?: PublicEvent[] };
      const event = body.events?.[0];
      if (!event) return;
      nextEventLink.textContent = compactTitle(event.title);
      nextEventLink.href = `/events/?event=${encodeURIComponent(event.slug)}`;
      nextEventLink.setAttribute('aria-label', `Open details for ${event.title}`);
    } catch {
      // Keep the honest fallback copy when the public calendar is unavailable.
    }
  }

  loadNextEvent();
</script>
