---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/join/', label: 'Join', priority: true },
  { href: '/calendar/', label: 'Calendar' },
  { href: '/activities/', label: 'Adventures' },
  { href: '/dens/', label: 'Dens' },
  { href: '/about/', label: 'Our Pack' },
  { href: '/resources/', label: 'Resources' },
  { href: '/contact/', label: 'Contact' },
];
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="Pack 170 home">
      <span class="brand-mark" aria-hidden="true">170</span>
      <span>Pack <span style="color: var(--gold)">170</span></span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a href={link.href} class:list={{ 'nav-priority': link.priority }} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.setAttribute('data-open', String(open));
  };
  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  // On a phone the drawer covers the page it is navigating, so tapping the page behind it
  // has to dismiss it — otherwise the only way out is finding the button again.
  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    if (toggle.contains(target) || nav?.contains(target)) return;
    setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
    setOpen(false);
    toggle.focus();
  });
</script>
