---
// The official badge of rank from assets/official/. Used in every rank-path grid, so the three
// pages that show one cannot drift apart.
// ponytail: no `densities` — the source badges are only 140px square, so a 2x of 118 would upscale.
import { Image } from 'astro:assets';
import { officialImage } from '../lib/official-image';

type Props = { emblem: string; name: string };
const { emblem, name } = Astro.props;
---

<Image class="rank__emblem" src={officialImage(emblem)} alt={`${name} badge of rank`} width={118} height={118} loading="lazy" />

<style>
  .rank__emblem {
    display: block;
    width: 100%;
    max-width: 118px;
    height: auto;
    margin: 0 auto 0.75rem;
  }
</style>
