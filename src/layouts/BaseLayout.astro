---
// Only the weights the stylesheets actually ask for. Montserrat 600 and Source Sans 3 600
// were imported and never used, which shipped six unused woff2 files per family and two
// dead @font-face blocks into the stylesheet every page loads.
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/montserrat/900.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/500.css';
import '@fontsource/source-sans-3/700.css';
// The chapter-hero <h1> is the LCP element on every route, and it is Montserrat 900. Left to
// the bundled CSS, its woff2 is only discovered after that CSS parses - one serialized round
// trip in front of the largest paint. Importing the file gives us the same hashed asset the
// @font-face already points at, so the preload matches the request instead of duplicating it.
import montserrat900 from '@fontsource/montserrat/files/montserrat-latin-900-normal.woff2';
import sourceSans400 from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import PackStrip from '../components/PackStrip.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { organizationSchema } from '../lib/event-schema';
import { getCalendarEvents, type CalendarEvent } from '../lib/calendar-client';

type Props = {
  title: string;
  description: string;
  showStrip?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};
const { title, description, showStrip = true, noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [organizationSchema(), ...pageSchemas];

let nextEvent: CalendarEvent | null = null;
if (showStrip) {
  try {
    nextEvent = (await getCalendarEvents())[0] ?? null;
  } catch (error) {
    // Degrade, never fail: a CMS outage must not block an unrelated deploy. This also fires
    // when a SINGLE event fails validation, because getCalendarEvents validates the whole list
    // and rejects all of it — a likelier trigger than an outage. Log loudly so a silently
    // placeholder-only build is visible in CI instead of looking healthy.
    console.warn('[pack-strip] build-time next-event fetch failed; keeping the placeholder:', error);
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover lets the blue header and gold strip run under a notch instead of
         sitting in a letterbox; the safe-area insets in global.css keep content clear of it. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#003f87" />
    <link rel="preload" href={montserrat900} as="font" type="font/woff2" crossorigin /><link
      rel="preload"
      href={sourceSans400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- iOS ignores the SVG icon and needs an opaque square, so the badge sits on its own
         Midnight field there rather than being masked against white. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title} | Cub Scout Pack 170</title>
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    {showStrip && <PackStrip nextEvent={nextEvent} />}
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
